<link rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css"
      integrity="sha512-hoalWLoI8r4UszCkZ5kL8vayOGVae1oxXe/2A4AO6J9+580uKHDO3JdHb7NzwwzK5xr/Fs0W40kiNHxM9vyTtQ=="
      crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js"
        integrity="sha512-BB3hKbKWOc9Ez/TAwyWxNXeoV9c1v6FIeYiBieIWkpLjauysF18NzgR1MBNBXf8/KABdlkX68nAhlwcDFLGPCQ=="
        crossorigin=""></script>
<script type="text/javascript" src={Routes.static_path(@socket, "/assets/leaflet-centermarker.js")}></script>

<.itb icon="fa-chevron-left" to={Routes.source_index_path(@socket, :index)} what="Back"></.itb>
<.itb icon="fa-pencil" to={Routes.source_show_path(@socket, :edit, @source)} what="Edit"></.itb>

<h1 class="text-3xl font-bold text-accent mx-4 py-2">Offering Detail</h1>

<.modal :if={@live_action == :edit} id="source-modal" show max_width="max-w-[67.2rem]" on_cancel={JS.patch(Routes.source_show_path(@socket, :show, @source))}>
<.live_component
module={RoomSanctumWeb.SourceLive.FormComponent}
id={@source.id}
title={@page_title}
action={@live_action}
source={@source}
patch={Routes.source_show_path(@socket, :show, @source)}
current_user={@current_user}
gh_available_repos={@github_available_repos}
gl_available_projects={@gitlab_available_projects}
/>
</.modal>
<div class="mx-4 py-2">
    <div class="flex">
        <h2 class="text-2xl font-bold text-accent-300"><%= @source.name %> (<%= @source.type %>)</h2>
    </div>
    <div class="flex">
        <div class="card card-compact w-1/8 bg-base-100 shadow-xl m-2">
            <div class="card-body text-center">
                <%= case @source.enabled do %>
                <%= true -> %>
                <i class="fa-solid fa-fw fa-check fa-6x" phx-click="toggle-source-enabled" phx-value-current="true"></i>
                <span class="text-xs">Enabled</span>
                <% false -> %>
                <i class="fa-solid fa-fw fa-times fa-6x text-warning" phx-click="toggle-source-enabled"
                   phx-value-current="false"></i>
                <span class="text-xs text-warning">Disabled</span>
                <% end %>
            </div>
        </div>
        <%= if @source.notes do %>
        <div class="card card-compact w-1/2 bg-base-100 shadow-xl m-2">
            <div class="card-body">
                <h3 class="card-title">User Notes:</h3>
                <p><%= @source.notes %></p>
            </div>
        </div>
        <% end %>
        <div class="card card-compact w-3/4 bg-base-100 shadow-xl m-2">
            <div class="card-body">
                <h3 class="card-title">Config
                    <%= if @source.meta.tint do %>
                    <i class={"fa fa-circle text-#{@source.meta.tint}-500"}></i>
                    <% end %></h3>
                <pre><%= @source.config |> Poison.encode!( pretty: true) %></pre>
            </div>
        </div>
    </div>
    <%= case @source.type do %>
        <% :packages -> %>
    <div class="flex">
        <div class="card card-compact w-1/2 bg-base-100 shadow-xl m-2">
            <div class="card-body">
                <div class="flex flex-col">
                    <div class="card-title">Webhooks</div>
                    <div class="py-1">
                        <ul>
                        <%= for w <- @source.webhooks do %>
                        <li>https://<%= w.user %>:<%= w.token %>@ac.gmp.io/api/data/<%= w.path %></li>
                        <% end %>
                        </ul>
                        <br/>
                        Last Triggered <%= @source.meta |> is_updated %>
                    </div>
                </div>
            </div>
        </div>
        <div class="card card-compact w-1/2 bg-base-100 shadow-xl m-2">
            <div class="card-body">
                <div class="flex flex-col">
                    <div class="card-title">Mails</div>
                    <div class="py-1">
                        <ul>
                            <%= for w <- @source.mailboxes do %>
                            <li><b><%= w.designator %>:</b> <%= w.user %>@ac.gmp.io</li>
                            <% end %>
                        </ul>
                        <br/>
                        Last Triggered <%= @source.meta |> is_updated %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% _otherwise -> %>
    <% end %>
    <div class="flex">
        <div class="card card-compact w-1/4 bg-base-100 shadow-xl m-2">
            <div class="card-body">
                <div class="flex justify-between">
                    <div class="card-title">Control</div>
                    <div class="py-1">
                        <%= case @source.type do %>
                    <% :gtfs -> %>
                        Last Updated <%= @source.meta |> is_updated %>
                    <% _default -> %>
                    <% end %>
                    </div>
                </div>
                <%= case @source.type do %>
                <% :gtfs -> %>
                <button class="btn btn-secondary" phx-click="do-update" phx-value-type="gtfs" phx-value-id={@source.id}>
                    Update
                </button>
                <% :gbfs -> %>
                <button class="btn btn-secondary" phx-click="do-update" phx-value-type="gbfs" phx-value-id={@source.id}>
                    Update
                </button>
                <% :aqi -> %>
                <button class="btn btn-secondary" phx-click="do-update" phx-value-type="aqi" phx-value-id={@source.id}>
                    Update
                </button>
                <% :calendar -> %>
                <button class="btn btn-secondary" phx-click="do-update" phx-value-type="ical" phx-value-id={@source.id}>
                    Update
                </button>
                <% :gitlab -> %>
                <button class="btn btn-secondary" phx-click="gitlab-open-config">
                    <i class="fa-solid fa-fw fa-sliders mr-1"></i>Configure Watched
                </button>
                <div class="text-xs mt-2 text-base-content/70">
                    <%= length(@source.config.projects || []) %> projects,
                    <%= length(Map.get(@source.config, :namespaces) || []) %> namespaces watched
                </div>
                <% :github -> %>
                <button class="btn btn-secondary" phx-click="github-open-config">
                    <i class="fa-solid fa-fw fa-sliders mr-1"></i>Configure Watched
                </button>
                <div class="text-xs mt-2 text-base-content/70">
                    <%= length(Map.get(@source.config, :repos) || []) %> repos,
                    <%= length(Map.get(@source.config, :owners) || []) %> owners watched
                </div>
                <% :packages -> %>
                    <form action="" novalidate="" role="submit" phx-submit="submit-pkg">
                        <input
                        id="submit-input"
                        name="submit[query]"
                        class="flex-auto rounded-lg appearance-none bg-transparent pl-10 text-zinc-900 outline-none focus:outline-none border-slate-200 focus:border-slate-200 focus:ring-0 focus:shadow-none placeholder:text-zinc-500 focus:w-full focus:flex-none sm:text-sm [&::-webkit-search-cancel-button]:hidden [&::-webkit-search-decoration]:hidden [&::-webkit-search-results-button]:hidden [&::-webkit-search-results-decoration]:hidden pr-4"
                        autocomplete="off"
                        autocorrect="off"
                        autocapitalize="off"
                        enterkeyhint="search"
                        spellcheck="false"
                        placeholder="Submit something..."
                        type="search"
                        value=""
                        tabindex="0"
                        />
                    </form>
                <% :bourse -> %>
                    <form phx-change="bourse-look" phx-submit="bourse-look">
                        <div class="form-control">
                            <label class="label label-text py-1">Ticker symbol</label>
                            <input type="text" name="sym[symbol]" value={@bourse_symbol}
                                   placeholder="AAPL, ^GSPC, BTC-USD"
                                   phx-debounce="500"
                                   class="input input-bordered input-sm" />
                        </div>
                    </form>

                    <%= if @bourse_preview do %>
                    <div class="mt-2 p-2 rounded bg-base-200">
                        <div class="text-xs opacity-70">
                            <%= @bourse_preview.symbol %><%= if @bourse_preview[:name], do: " · #{@bourse_preview.name}" %>
                        </div>
                        <%= if @bourse_preview[:price] do %>
                        <div class="text-2xl font-mono font-bold">
                            <%= RoomBourse.Worker.format_price(@bourse_preview.price) %>
                        </div>
                        <div class="text-xs font-mono">
                            <%= RoomBourse.Worker.format_change(@bourse_preview[:change]) %>
                            <%= RoomBourse.Worker.format_pct(@bourse_preview[:change_pct]) %>
                            <%= if @bourse_preview[:currency], do: " #{@bourse_preview.currency}" %>
                        </div>
                        <% else %>
                        <div class="text-sm opacity-70"><%= @bourse_preview[:error] || "unavailable" %></div>
                        <% end %>
                    </div>
                    <% end %>

                    <button class="btn btn-secondary btn-sm mt-2" phx-click="bourse-add"
                            disabled={is_nil(@bourse_symbol)}>
                        <i class="fa-solid fa-plus mr-1"></i>Add as query
                    </button>

                <% :treasury -> %>
                    <form phx-change="treasury-pick">
                        <div class="form-control">
                            <label class="label label-text py-1">From</label>
                            <select name="pair[from]" class="select select-bordered select-sm">
                                <option value="">Pick a currency</option>
                                <%= for {group, opts} <- RoomTreasury.Currencies.grouped(RoomSanctum.Configuration.Configs.Treasury.enabled_categories(@source.config)) do %>
                                <optgroup label={group}>
                                    <%= for {label, value} <- opts do %>
                                    <option value={value} selected={value == @treasury_from}><%= label %></option>
                                    <% end %>
                                </optgroup>
                                <% end %>
                            </select>
                        </div>
                        <div class="flex justify-center -my-1">
                            <button type="button" class="btn btn-xs btn-circle btn-ghost"
                                    phx-click="treasury-swap" title="Swap">
                                <i class="fa-solid fa-arrow-right-arrow-left fa-rotate-90"></i>
                            </button>
                        </div>
                        <div class="form-control">
                            <label class="label label-text py-1">To</label>
                            <select name="pair[to]" class="select select-bordered select-sm">
                                <option value="">Pick a currency</option>
                                <%= for {group, opts} <- RoomTreasury.Currencies.grouped(RoomSanctum.Configuration.Configs.Treasury.enabled_categories(@source.config)) do %>
                                <optgroup label={group}>
                                    <%= for {label, value} <- opts do %>
                                    <option value={value} selected={value == @treasury_to}><%= label %></option>
                                    <% end %>
                                </optgroup>
                                <% end %>
                            </select>
                        </div>
                    </form>

                    <%= if @treasury_preview do %>
                    <div class="mt-2 p-2 rounded bg-base-200">
                        <div class="text-xs opacity-70"><%= @treasury_preview.pair %></div>
                        <%= if @treasury_preview[:rate] do %>
                        <div class="text-2xl font-mono font-bold"><%= @treasury_preview.display %></div>
                        <div class="text-xs opacity-60"><%= @treasury_preview[:date] %></div>
                        <% else %>
                        <div class="text-sm opacity-70"><%= @treasury_preview[:error] || "unavailable" %></div>
                        <% end %>
                    </div>
                    <% end %>

                    <button class="btn btn-secondary btn-sm mt-2" phx-click="treasury-add"
                            disabled={is_nil(@treasury_from) or is_nil(@treasury_to)}>
                        <i class="fa-solid fa-plus mr-1"></i>Add as query
                    </button>

                <% _default -> %>

                <% end %>
            </div>
        </div>
        <div class="card card-compact w-1/4 bg-base-100 shadow-xl m-2">
            <div class="card-body">
                <h3 class="card-title">Worker Status</h3>
                <%= @status %>
                <progress class="progress progress-secondary w-100" value={@status_val} max="100"></progress>
            </div>
        </div>
        <div class="card card-compact w-1/4 bg-base-100 shadow-xl m-2">
            <div class="card-body">
                <h3 class="card-title">Stats</h3>
                <%= case @source.type do %>
                    <% :gtfs -> %>
                <button class="btn btn-secondary" phx-click="do-stats" phx-value-type="gtfs" phx-value-id={@source.id}>
                    Calculate
                </button>
                <% :gbfs -> %>
                <button class="btn btn-secondary" phx-click="do-stats" phx-value-type="gbfs" phx-value-id={@source.id}>
                    Calculate
                </button>
                <% :aqi -> %>
                <button class="btn btn-secondary" phx-click="do-stats" phx-value-type="aqi" phx-value-id={@source.id}>
                    Calculate
                </button>
                <% :calendar -> %>
                <button class="btn btn-secondary" phx-click="do-stats" phx-value-type="calendar"
                        phx-value-id={@source.id}>Calculate
                </button>
                <% _default -> %>
                <% end %>
            </div>
        </div>
    </div>

    <%= if @stats != %{} do %>
    <div class="flex">
        <div class="card card-compact w-full bg-base-100 shadow-xl m-2">
            <div class="card-body">
                <h3 class="card-title">Stats Results</h3>
                <div class="flex justify-evenly">
                    <%= for {type,data} <-  @stats  do %>
                    <div>
                        <div class="font-bold uppercase"><%= type %> </div>
                            <ul class="menu bg-primary rounded">
                            <%= for {data_k, data_v} <- data do %>
                            <li class="text-primary-content uppercase">
                                <a><%= data_k %> <span class="text-accent"><%= data_v %></span></a>
                            </li>
                            <% end %>
                        </ul>
                    </div>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
    <% end %>

    <div class="flex">
        <div class="card card-compact w-full bg-base-100 shadow-xl m-2">
            <div class="card-body">
                <h3 class="card-title flex justify-between">
                    <div class="flex items-center gap-2">
                        Queries
                        <button 
                          class="btn btn-sm btn-outline ml-4 text-xs" 
                          phx-click="toggle-view"
                        >
                          <i class={"fa-solid #{if @view_mode == :system, do: "fa-map", else: "fa-table"} mr-1"}></i>
                          <%= if @view_mode == :system, do: "Map View", else: "System View" %>
                        </button>
                        
                        <!-- Available tints - clickable filters -->
                        <span class="text-amber-500"></span>
                        <span class="text-lime-500"></span>
                        <span class="text-emerald-500"></span>
                        <span class="text-sky-500"></span>
                        <span class="text-violet-500"></span>
                        <span class="text-fuchsia-500"></span>
                        <span class="text-rose-500"></span>
                        <span class="text-stone-500"></span>
                        <span class="text-slate-500"></span>
                        <span class="text-stone-950"></span>
                        
                        <%= for tint <- @available_tints do %>
                          <span class="cursor-pointer mx-1" phx-click="set-tint" phx-value-tint={tint}>
                            <i class={"fa-solid fa-circle text-#{tint}-500 hover:text-#{tint}-700 #{if @tint == tint, do: "text-lg", else: ""}"}></i>
                          </span>
                        <% end %>
                    </div>
                    
                    <%= case @source.type do %>
                    <% val when val in [:gtfs, :gbfs] -> %>
                    <span class="" phx-click="add-tester"><i class="fa-solid fa-plus"></i>Test</span>
                    <% _default -> %>
                    <% end %>
                </h3>
                
                <%= if @view_mode == :detail do %>
                  <div class="px-6">
                    <.query_geospatial_map 
                      queries={filter_queries_by_tint(@queries, @tint)}
                      vehicle_positions={@vehicle_positions}
                      free_bikes={@free_bikes}
                      stations={@stations}
                      station_statuses={@station_statuses}
                      source_tint={@source_tint}
                      selected_tint={@tint}
                      class=""
                      height="600px"
                    />
                  </div>
                <% else %>
                  <div class="flex flex-wrap gap-2">
                    <%= for q <- filter_queries_by_tint(@queries, @tint) do %>
                    <%= live_patch to: Routes.query_show_path(@socket, :show, q.id), class: "btn btn-primary float-left" do %>
                        <%= cond do %>
                        <% q.meta && q.meta.tint && q.source.meta.tint -> %>
                          <!-- Both query and source tints - use fa-stack -->
                          <span class="fa-stack">
                            <i class={"fa-solid fa-circle fa-fw fa-stack-1x z-30 text-#{q.source.meta.tint}-500"}></i>
                            <i class={"fa-solid fa-circle fa-fw z-40 fa-stack-1x text-#{q.meta.tint}-500"} data-fa-transform="shrink-3 right-4"></i>

                          </span>
                        <% q.meta && q.meta.tint -> %>
                          <!-- Query tint only -->
                          <i class={"fa-solid fa-circle-half-stroke fa-spin fa-fw text-#{q.meta.tint}-500"}></i>
                        <% q.source.meta.tint -> %>
                          <!-- Source tint only -->
                          <i class={"fa-solid fa-circle text-#{q.source.meta.tint}-500"}></i>
                        <% true -> %>
                          <!-- No tints -->
                      <% end %>
                    <i class={"fas #{get_icon(q.source.type)}"}></i>&emsp;<%= q.name %>
                  <% end %>
                <% end %>
                  </div>
                <% end %>
            </div>
        </div>
    </div>
    <%= if @tester do %>
    <div class="flex">
        <div class="card card-compact w-full bg-base-100 shadow-xl m-2">
            <div class="card-body">
                <h3 class="card-title flex justify-between">
                    Tester
                    <span class="" phx-click="add-tester"><i class="fa-solid fa-close"></i></span>
                </h3>
                <p>
                    <%= case @source.type do %>
                    <% :gtfs -> %>
                <div class="flex justify-between">
                    <div class="flex flex-col">
                        <div class="">
                            <form phx-change="do-gtfs-search" phx-debounce="100">
                                <fieldset>
                                    <label for="name">Term</label>
                                    <input type="hidden" value={@source_id} name="id"/>
                                    <input type="term" name="name" value={@tester_query}
                                           placeholder="Main Street"
                                           autofocus autocomplete="off"
                                           class="input input-bordered input-info w-full max-w-xs"
                                    />
                                </fieldset>
                            </form>
                        </div>
                        <div class="">
                            <ul class="menu bg-secondary rounded">
                                <%= for r <- @tester_results |> Enum.slice(0..25) do %>
                                <li class="hover-bordered">
                                    <a class="text-secondary-content" phx-click="pick-result" phx-value-id={r |>
                                        Map.from_struct |> Map.get :stop_id} phx-value-name={r |> Map.from_struct |>
                                        Map.get :stop_name}>
                                        <div class="flex justify-between w-full">
                                            <div><%= r |> Map.from_struct |> Map.get :stop_name %></div>
                                            <div class="badge badge-accent"><%= r |> Map.from_struct |> Map.get :stop_id  %></div>
                                        </div>
                                    </a>
                                </li>
                                <% end %>
                            </ul>
                        </div>
                    </div>
                    <div class="flex flex-col gap-2">
                        <div class="text-xl">Selected: <%= @tester_selected_name %></div>
                        <div class="text-xs">id: <%= @tester_selected %></div>
                        <div class="">
                            <%= if @tester_selected_data != %{} and @tester_selected != nil do %>
                            <.p_gtfs entries={condense({@source_id, :gtfs}, @tester_selected_data) |>
                            preview({@source_id, :gtfs})} />
                            <%= if @tester_selected_data != %{} do %>
                            <span phx-click="add-query"><i class="fa fa-plus fa-fw"></i>query</span>
                            <% end %>
                            <% else %>
                            -waiting on data-
                            <% end %>
                        </div>
                    </div>
                </div>
                <% :gbfs -> %>
                <div class="flex justify-between gap-4">
                    <div class="flex flex-col gap-2">
                        <div class="">
                            <div class="flex flex-col w-full border-opacity-50">
                                <div class="grid h-20 card bg-base-300 rounded-box place-items-center">
                                    <form phx-change="do-gbfs-search" phx-debounce="100">
                                        <fieldset>
                                            <label for="name">Term</label>
                                            <input type="hidden" value={@source_id} name="id"/>
                                            <input type="term" name="name" value={@tester_query}
                                                   placeholder="Main Street"
                                                   autofocus autocomplete="off"
                                                   class="input input-bordered input-info w-full max-w-xs"
                                            />
                                        </fieldset>
                                    </form>
                                </div>
                                <div class="divider">OR</div>
                                <div class="grid h-20 card bg-base-300 rounded-box place-items-center">
                                    <form phx-change="select-foci">
                                        <label for="foci">Select Foci:</label>
                                        <select name="foci" id="foci">
                                            <%= for option <- @tester_foci do %>
                                            <option value={ option.place.coordinates |> pt_for_form
                                                }><%= option.name %></option>
                                            <% end %>
                                        </select>
                                        <label for="distance">Distance <%= @tester_foci_distance %></label>
                                        <input type="range" min="0" max="250" value="100" class="range"
                                               name="distance"/>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="">
                            <ul class="menu bg-secondary rounded">
                                <%= for r <- @tester_results |> Enum.slice(0..10) do %>
                                <li class="hover-bordered">
                                    <a class="text-secondary-content" phx-click="pick-result" phx-value-id={r |>
                                        Map.from_struct |> Map.get :station_id} phx-value-name={r |> Map.from_struct |>
                                        Map.get :name}>
                                        <div class="flex justify-between w-full">
                                            <div><%= r |> Map.from_struct |> Map.get :name %></div>
                                            <div class="badge badge-accent"><%= r |> Map.from_struct |> Map.get :station_id  %></div>
                                        </div>
                                    </a>
                                </li>
                                <% end %>
                            </ul>
                        </div>
                    </div>
                    <div class="flex flex-col gap-2 h-full" id="foci_map" phx-update="replace">
                        <leaflet-map style="height: 400px; width: 600px" lat={@tester_foci_coords_lat}
                                     lng={@tester_foci_coords_lon} zoom="13" class="h-full">
                            <%= for marker <- @tester_foci_vehicles do %>
                            <leaflet-marker
                                    lat={ marker.point.coordinates |> get_second }
                                lng={ marker.point.coordinates |> get_first }
                                selected={false}
                                phx-click="toggle_marker"
                                phx-value-id={ marker.id }>
                                <leaflet-icon
                                        icon-url={ get_icon_url(false) }
                                        width="64"
                                        height="64">
                                </leaflet-icon>
                            </leaflet-marker>
                            <% end %>
                        </leaflet-map>
                    </div>
                    <div class="flex flex-col gap-2">
                        <div class="text-xl">Selected: <%= @tester_selected_name %></div>
                        <div class="text-xs">id: <%= @tester_selected %></div>
                        <div class="">
                            <%= if @tester_selected_data != %{} and @tester_selected != nil do %>
                            <.p_gbfs entries={condense({@source_id, :gbfs}, @tester_selected_data) |>
                            preview({@source_id, :gbfs})} />
                            <span phx-click="add-query"><i class="fa fa-plus fa-fw"></i>query</span>
                            <% else %>
                            -waiting on data-
                            <% end %>
                        </div>
                        <div class="">
                            brrr <br/>
                            brrr <br/>brrr <br/>brrr <br/>brrr <br/>brrr <br/>brrr <br/>
                        </div>
                    </div>
                </div>
                <% _default -> %>
                    <% end %>
                </p>
            </div>
        </div>
    </div>
    <% end %>

    <%= if @source.type == :gitlab and @gitlab_config_open do %>
    <% watched_projects = (@source.config.projects || []) |> Enum.map(&to_string/1) |> MapSet.new() %>
    <% watched_namespaces = (Map.get(@source.config, :namespaces) || []) |> MapSet.new() %>
    <% grouped =
         @gitlab_available_projects
         |> Enum.group_by(fn p -> get_in(p, ["namespace", "full_path"]) || "(unknown)" end)
         |> Enum.sort_by(fn {ns, _} -> ns end) %>
    <div class="modal modal-open">
        <div class="modal-box max-w-4xl">
            <h3 class="font-bold text-lg flex justify-between items-center">
                Watched Projects &amp; Namespaces
                <span class="cursor-pointer" phx-click="gitlab-close-config">
                    <i class="fa-solid fa-close"></i>
                </span>
            </h3>
            <div class="py-2 flex gap-2 items-center">
                <button class="btn btn-sm btn-secondary" phx-click="gitlab-refresh-projects">
                    <i class="fa-solid fa-rotate mr-1"></i>Refresh from GitLab
                </button>
                <span class="text-xs text-base-content/70">
                    <%= length(@gitlab_available_projects) %> available -
                    check a namespace to watch all of its projects, or pick projects individually.
                    Empty selection = watch everything.
                </span>
            </div>
            <div class="max-h-[60vh] overflow-y-auto">
                <%= for {ns, projects} <- grouped do %>
                <% ns_watched = MapSet.member?(watched_namespaces, ns) %>
                <div class="border border-base-300 rounded my-2 p-2">
                    <div class="flex items-center justify-between">
                        <label class="flex items-center gap-2 font-semibold cursor-pointer">
                            <input type="checkbox" class="checkbox checkbox-sm"
                                   checked={ns_watched}
                                   phx-click="gitlab-toggle-namespace"
                                   phx-value-path={ns} />
                            <i class="fa-solid fa-folder"></i>
                            <%= ns %>
                            <span class="text-xs text-base-content/60">(<%= length(projects) %>)</span>
                        </label>
                        <button class="btn btn-xs btn-outline btn-success"
                                phx-click="gitlab-query-namespace"
                                phx-value-path={ns}
                                title={"Create query for namespace #{ns} (auto-watches)"}>
                            <i class="fa-solid fa-plus"></i>query namespace
                        </button>
                    </div>
                    <div class={"pl-6 mt-1 #{if ns_watched, do: "opacity-50", else: ""}"}>
                        <%= for p <- Enum.sort_by(projects, & &1["name"]) do %>
                        <% pid = p["id"] |> to_string() %>
                        <div class="flex items-center justify-between py-0.5">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" class="checkbox checkbox-xs"
                                       checked={ns_watched or MapSet.member?(watched_projects, pid)}
                                       disabled={ns_watched}
                                       phx-click="gitlab-toggle-project"
                                       phx-value-id={pid} />
                                <span class="text-sm"><%= p["name"] %></span>
                                <span class="badge badge-ghost badge-sm"><%= pid %></span>
                            </label>
                            <button class="btn btn-xs btn-ghost btn-success opacity-70 hover:opacity-100"
                                    phx-click="gitlab-query-project"
                                    phx-value-id={pid}
                                    phx-value-name={p["name"]}
                                    title={"Create query for #{p["name"]} (auto-watches)"}>
                                <i class="fa-solid fa-plus"></i>query
                            </button>
                        </div>
                        <% end %>
                    </div>
                </div>
                <% end %>
                <%= if @gitlab_available_projects == [] do %>
                <div class="text-center py-8 text-base-content/60">
                    No projects loaded yet. Click "Refresh from GitLab" to fetch.
                </div>
                <% end %>
            </div>
            <div class="modal-action">
                <button class="btn btn-primary" phx-click="gitlab-close-config">Done</button>
            </div>
        </div>
    </div>
    <% end %>

    <%= if @source.type == :github and @github_config_open do %>
    <% watched_repos = (Map.get(@source.config, :repos) || []) |> MapSet.new() %>
    <% watched_owners = (Map.get(@source.config, :owners) || []) |> MapSet.new() %>
    <% gh_grouped =
         @github_available_repos
         |> Enum.group_by(fn r -> get_in(r, ["owner", "login"]) || "(unknown)" end)
         |> Enum.sort_by(fn {o, _} -> o end) %>
    <div class="modal modal-open">
        <div class="modal-box max-w-4xl">
            <h3 class="font-bold text-lg flex justify-between items-center">
                Watched Repos &amp; Owners
                <span class="cursor-pointer" phx-click="github-close-config">
                    <i class="fa-solid fa-close"></i>
                </span>
            </h3>
            <div class="py-2 flex gap-2 items-center">
                <button class="btn btn-sm btn-secondary" phx-click="github-refresh-repos">
                    <i class="fa-solid fa-rotate mr-1"></i>Refresh from GitHub
                </button>
                <span class="text-xs text-base-content/70">
                    <%= length(@github_available_repos) %> available -
                    check an owner to watch all their repos, or pick repos individually.
                    Empty selection = watch everything reachable by the PAT.
                </span>
            </div>
            <div class="max-h-[60vh] overflow-y-auto">
                <%= for {owner, repos} <- gh_grouped do %>
                <% own_watched = MapSet.member?(watched_owners, owner) %>
                <div class="border border-base-300 rounded my-2 p-2">
                    <div class="flex items-center justify-between">
                        <label class="flex items-center gap-2 font-semibold cursor-pointer">
                            <input type="checkbox" class="checkbox checkbox-sm"
                                   checked={own_watched}
                                   phx-click="github-toggle-owner"
                                   phx-value-owner={owner} />
                            <i class="fa-brands fa-github"></i>
                            <%= owner %>
                            <span class="text-xs text-base-content/60">(<%= length(repos) %>)</span>
                        </label>
                        <div class="flex gap-1">
                            <button class="btn btn-xs btn-outline btn-success"
                                    phx-click="github-query-owner"
                                    phx-value-owner={owner}
                                    phx-value-level="runs"
                                    title={"Create runs query for owner #{owner} (auto-watches)"}>
                                <i class="fa-solid fa-plus"></i>runs
                            </button>
                            <button class="btn btn-xs btn-outline btn-success"
                                    phx-click="github-query-owner"
                                    phx-value-owner={owner}
                                    phx-value-level="jobs"
                                    title={"Create jobs query for owner #{owner} (auto-watches)"}>
                                <i class="fa-solid fa-plus"></i>jobs
                            </button>
                        </div>
                    </div>
                    <div class={"pl-6 mt-1 #{if own_watched, do: "opacity-50", else: ""}"}>
                        <%= for r <- Enum.sort_by(repos, & &1["name"]) do %>
                        <% full = r["full_name"] %>
                        <div class="flex items-center justify-between py-0.5">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" class="checkbox checkbox-xs"
                                       checked={own_watched or MapSet.member?(watched_repos, full)}
                                       disabled={own_watched}
                                       phx-click="github-toggle-repo"
                                       phx-value-full_name={full} />
                                <span class="text-sm"><%= r["name"] %></span>
                                <%= if r["private"] do %>
                                  <span class="badge badge-warning badge-xs">private</span>
                                <% end %>
                                <%= if r["archived"] do %>
                                  <span class="badge badge-ghost badge-xs">archived</span>
                                <% end %>
                            </label>
                            <div class="flex gap-1">
                                <button class="btn btn-xs btn-ghost btn-success opacity-70 hover:opacity-100"
                                        phx-click="github-query-repo"
                                        phx-value-full_name={full}
                                        phx-value-level="runs"
                                        title={"Create runs query for #{full} (auto-watches)"}>
                                    <i class="fa-solid fa-plus"></i>runs
                                </button>
                                <button class="btn btn-xs btn-ghost btn-success opacity-70 hover:opacity-100"
                                        phx-click="github-query-repo"
                                        phx-value-full_name={full}
                                        phx-value-level="jobs"
                                        title={"Create jobs query for #{full} (auto-watches)"}>
                                    <i class="fa-solid fa-plus"></i>jobs
                                </button>
                            </div>
                        </div>
                        <% end %>
                    </div>
                </div>
                <% end %>
                <%= if @github_available_repos == [] do %>
                <div class="text-center py-8 text-base-content/60">
                    No repos loaded yet. Click "Refresh from GitHub" to fetch.
                </div>
                <% end %>
            </div>
            <div class="modal-action">
                <button class="btn btn-primary" phx-click="github-close-config">Done</button>
            </div>
        </div>
    </div>
    <% end %>
</div>
