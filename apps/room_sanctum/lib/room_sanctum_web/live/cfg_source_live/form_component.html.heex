<div>
    <h2 class="text-3xl font-bold text-accent"><%= @title %></h2>

    <.simple_form
    for={@form}
    id="source-form"
    phx-target={@myself}
    phx-change="validate"
    phx-submit="save">

    <div class="flex">
        <div class="w-full">
            <div class="form-control">
                <.input field={@form[:name]} type="text" label="Name"/>
            </div>

            <div class="form-control">
                <.input field={@form[:notes]} type="text" label="Notes"/>
            </div>

            <div class="form-control">
                <.input field={@form[:type]} type="radio_grid" label="Type" options={RoomSanctumWeb.SourceTypeInfo.all()} />
            </div>
        </div>
        <div class="w-1/4">
            <div class="form-control m-10">
                <.input field={@form[:enabled]} type="checkbox" label="Enabled" />
            </div>
            <.inputs_for :let={meta_nested} field={@form[:meta]}>
            <div class="form-control m-10">
                <span class="bg-amber-500"></span>
                <span class="bg-lime-500"></span>
                <span class="bg-emerald-500"></span>
                <span class="bg-sky-500"></span>
                <span class="bg-violet-500"></span>
                <span class="bg-fuchsia-500"></span>
                <span class="bg-rose-500"></span>
                <span class="bg-stone-500"></span>
                <span class="bg-slate-500"></span>
                <span class="bg-stone-950"></span>
                <.input field={meta_nested[:tint]} type="hidden" label="Tint"/>
                <.input field={meta_nested[:tint]} type="radio" label="Tint" options={@tint_opts} prompt="color this" checked_value={meta_nested.params["tint"]} />
            </div>
            </.inputs_for>

        </div>
    </div>

    <%= case @form.source |> Map.get(:changes) |> Map.get(:type) || @form.data |> Map.get(:type) do %>
    <%= :aqi -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :aqi, fn _aqi_form -> %>
    <% end %>

    <% :calendar -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :calendar, fn cal_form -> %>
    <div class="form-control">
        <.input field={cal_form[:url]} type="text" label="iCal URL"/>
    </div>
    <% end %>

    <% :ephem -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :ephem, fn _eph_form -> %>
    <% end %>

    <% :gtfs -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :gtfs, fn gtfs_form -> %>
    <div class="form-control">
        <.input field={gtfs_form[:url]} type="text" label="URL"/>
    </div>
    <div class="form-control">
        <.input field={gtfs_form[:tz]} type="text" label="TZ"/>
    </div>
    <div class="form-control">
        <.input field={gtfs_form[:url_rt_sa]} type="text" label="Realtime URL Service Alerts"/>
    </div>
    <div class="form-control">
        <.input field={gtfs_form[:url_rt_tu]} type="text" label="Realtime URL Trip Updates"/>
    </div>
    <div class="form-control">
        <.input field={gtfs_form[:url_rt_vp]} type="text" label="Realtime URL Vehicle Positions"/>
    </div>
    <div class="form-control">
        <.input field={gtfs_form[:url_rt_shared]} type="text" label="Realtime URL (combined feed)"/>
        <label class="label">
            <span class="label-text-alt opacity-70">
                For an agency that publishes trip updates, vehicle positions and alerts in
                one feed &mdash; MTA subway does. Fills in whichever of the three above are
                left blank, and each is split out by entity type.
            </span>
        </label>
    </div>
    <%= for {_url, kinds} <- @rt_groups do %>
    <div class="form-control mt-2">
        <label class="label">
            <span class="label-text">
                <%= RoomSanctumWeb.SourceLive.FormComponent.rt_group_label(kinds) %> interval &mdash;
                <span class="font-bold">
                    <%= RoomSanctumWeb.SourceLive.FormComponent.rt_period_label(@rt_idxs[kinds]) %>
                </span>
            </span>
        </label>
        <input type="range"
            name={"source[config][#{RoomSanctumWeb.SourceLive.FormComponent.rt_group_key(kinds)}]"}
            id={"source_config_#{RoomSanctumWeb.SourceLive.FormComponent.rt_group_key(kinds)}"}
            min="0"
            max={length(RoomSanctumWeb.SourceLive.FormComponent.rt_period_steps()) - 1}
            step="1"
            value={@rt_idxs[kinds]}
            class="range range-sm range-secondary" />
        <div class="flex justify-between text-xs px-1 mt-1">
            <%= for {label, _secs} <- RoomSanctumWeb.SourceLive.FormComponent.rt_period_steps() do %>
                <span><%= label %></span>
            <% end %>
        </div>
    </div>
    <% end %>
    <p :if={@rt_groups != []} class="text-xs text-base-content/60 mt-1">
        One control per feed URL, since a URL is what gets fetched. Kinds arriving in
        the same feed are refreshed together &mdash; scheduling them apart would fetch
        that feed on the fastest of their clocks and then hand the others a staler copy
        of the message that had already arrived.
    </p>
    <div :if={@rt_groups != []} class="text-xs mt-2 opacity-80">
        <i class="fa-solid fa-fw fa-gauge-high"></i>
        Roughly <span class="font-bold"><%= @rt_requests %></span> requests an hour.
        511.org allows 60 on a default token.
    </div>
    <div class="form-control">
        <.input field={gtfs_form[:rt_agency]} type="text" label="Realtime operator code"/>
        <label class="label">
            <span class="label-text-alt opacity-70">
                Only for a feed carrying several agencies at once, such as 511's regional
                feed, where trips are keyed <code>SF:12074394_M21</code>. Selects this
                source's entities and strips the prefix. Leave blank otherwise.
            </span>
        </label>
    </div>
    <% end %>
    <div class="form-control mt-2">
      <label class="label"><span class="label-text">Static refresh interval</span></label>
      <input type="range"
        name="source[meta][run_period]"
        id="source_meta_run_period"
        min="0" max="5" step="1"
        value={@run_period_idx}
        class="range range-sm" />
      <div class="flex justify-between text-xs px-1 mt-1">
        <%= for {days, _secs} <- RoomSanctumWeb.SourceLive.FormComponent.run_period_steps() do %>
          <span><%= days %>d</span>
        <% end %>
      </div>
    </div>

    <% :gbfs -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :gbfs, fn gbfs_form -> %>
    <div class="form-control">
        <.input field={gbfs_form[:url]} type="text" label="URL"/>
    </div>
    <div class="form-control">
        <.input field={gbfs_form[:lang]} type="select" label="Language" options={[:en, :es, :fr, :pt, :it]} />
    </div>
    <% end %>

    <% :hass -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :hass, fn hass_form -> %>
    <div class="form-control">
        <.input field={hass_form[:url]} type="text" label="URL"/>
    </div>

    <div class="form-control">
        <.input field={hass_form[:api_key]} type="text" label="API Key"/>
    </div>
    <% end %>

    <% :rideshare -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :rideshare, fn rs_form -> %>
    <div class="form-control">
        <.input field={rs_form[:provider]} type="text" label="Provider"/>
        TODODODDODO
    </div>
    <div class="form-control">
        <.input field={rs_form[:api_key]} type="text" label="API Key"/>
    </div>
    <% end %>

    <% :tidal -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :tidal, fn _tidal_form -> %>
    <% end %>

    <% :weather -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :weather, fn weather_form -> %>

    <div class="form-control">
        <.input field={weather_form[:api_key]} type="text" label="API Key"/>
    </div>
    <div class="form-control">
        <.input field={weather_form[:units]} type="text" label="Units"/>
    </div>
    <% end %>

    <% :cronos -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :cronos, fn _cronos_form -> %>
    <% end %>

    <% :gitlab -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :gitlab, fn gitlab_form -> %>
    <div class="form-control">
        <.input field={gitlab_form[:url]} type="text" label="URL"/>
    </div>

    <div class="form-control">
        <.input field={gitlab_form[:pat]} type="text" label="PAT"/>
    </div>
    <% end %>
    <div class="form-control mt-2">
        <label class="label">
            <span class="label-text">
                Poll interval —
                <%
                  {gl_label, _} = Enum.at(RoomSanctumWeb.SourceLive.FormComponent.gitlab_poll_steps(), @gitlab_poll_idx, {"10s", 10})
                %>
                <span class="font-bold"><%= gl_label %></span>
            </span>
        </label>
        <input type="range"
            name="source[config][gitlab_poll_idx]"
            id="source_config_gitlab_poll_idx"
            min="0"
            max={length(RoomSanctumWeb.SourceLive.FormComponent.gitlab_poll_steps()) - 1}
            step="1"
            value={@gitlab_poll_idx}
            class="range range-sm range-secondary" />
        <div class="flex justify-between text-xs px-1 mt-1">
            <%= for {label, _secs} <- RoomSanctumWeb.SourceLive.FormComponent.gitlab_poll_steps() do %>
                <span><%= label %></span>
            <% end %>
        </div>
        <p class="text-xs text-base-content/60 mt-1">
            How often the worker polls GitLab jobs for status changes.
            Lower values = fresher data, more API calls (typical GitLab limit: 18000/hr authenticated).
        </p>
        <div class={"text-xs mt-2 #{RoomSanctumWeb.SourceLive.FormComponent.gitlab_estimate_class(@gitlab_estimate.calls)}"}>
            <i class="fa-solid fa-fw fa-gauge-high"></i>
            <%= case @gitlab_estimate.source do %>
            <% :unknown -> %>
                Estimated API calls: <span class="font-bold">unknown</span>
                — open Configure → Refresh from GitLab to populate the picker.
            <% :exact -> %>
                <%= if @gitlab_estimate.watched == 0 do %>
                  No projects watched. Worker will poll every accessible project on each cycle.
                <% else %>
                  Estimate: <span class="font-bold">~<%= @gitlab_estimate.calls %> API calls/hr</span>
                  (<%= @gitlab_estimate.watched %> projects × <%= @gitlab_estimate.cycles %> cycles).
                <% end %>
            <% :partial -> %>
                Estimate: <span class="font-bold">~<%= @gitlab_estimate.calls %>+ API calls/hr</span>
                (<%= @gitlab_estimate.watched %> known watched projects; some namespaces may add more — refresh in Configure for an accurate count).
            <% end %>
        </div>
    </div>

    <% :github -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :github, fn gh_form -> %>
    <div class="form-control">
        <.input field={gh_form[:api_url]} type="text" label="API URL (https://api.github.com or your GHE base)"/>
    </div>

    <div class="form-control">
        <.input field={gh_form[:pat]} type="text" label="Personal Access Token"/>
    </div>
    <% end %>
    <div class="form-control mt-2">
        <label class="label">
            <span class="label-text">
                Poll interval —
                <%
                  {label, _} = Enum.at(RoomSanctumWeb.SourceLive.FormComponent.github_poll_steps(), @github_poll_idx, {"1m", 60})
                %>
                <span class="font-bold"><%= label %></span>
            </span>
        </label>
        <input type="range"
            name="source[config][poll_idx]"
            id="source_config_poll_idx"
            min="0"
            max={length(RoomSanctumWeb.SourceLive.FormComponent.github_poll_steps()) - 1}
            step="1"
            value={@github_poll_idx}
            class="range range-sm range-secondary" />
        <div class="flex justify-between text-xs px-1 mt-1">
            <%= for {label, _secs} <- RoomSanctumWeb.SourceLive.FormComponent.github_poll_steps() do %>
                <span><%= label %></span>
            <% end %>
        </div>
        <p class="text-xs text-base-content/60 mt-1">
            How often the worker polls GitHub for workflow run/job status changes.
            Lower values = fresher data, more API calls (limit: 5000/hr authenticated).
        </p>
        <div class={"text-xs mt-2 #{RoomSanctumWeb.SourceLive.FormComponent.github_estimate_class(@github_estimate.calls)}"}>
            <i class="fa-solid fa-fw fa-gauge-high"></i>
            <%= case @github_estimate.source do %>
            <% :unknown -> %>
                Estimated API calls: <span class="font-bold">unknown</span>
                — open Configure → Refresh from GitHub to populate the picker.
            <% :exact -> %>
                <%= if @github_estimate.watched == 0 do %>
                  No repos watched. Worker will fall back to polling every accessible repo on each cycle.
                <% else %>
                  Estimate: <span class="font-bold">~<%= @github_estimate.calls %> API calls/hr</span>
                  (<%= @github_estimate.watched %> repos × 2 calls × <%= @github_estimate.cycles %> cycles).
                  GitHub limit: 5000/hr.
                <% end %>
            <% :partial -> %>
                Estimate: <span class="font-bold">~<%= @github_estimate.calls %>+ API calls/hr</span>
                (<%= @github_estimate.watched %> known watched repos; some owners may add more — refresh in Configure for an accurate count). GitHub limit: 5000/hr.
            <% end %>
        </div>
    </div>

    <% :icarus -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :icarus, fn icarus_form -> %>
    <div class="form-control">
        <.input field={icarus_form[:endpoint]} type="text" label="adsb.fi API base" />
        <p class="text-xs text-base-content/60 mt-1">
            No API key needed &mdash; adsb.fi's open data endpoints are public, rate limited to
            1 request/second. Leave the default unless you feed adsb.fi and have your own instance.
            Open data is for personal, non-commercial use; previews link back to adsb.fi as required.
        </p>
    </div>
    <% end %>

    <% :pollen -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :pollen, fn pollen_form -> %>
    <div class="form-control">
        <.input field={pollen_form[:api_key]} type="text" label="Google Pollen API Key" />
        <p class="text-xs text-base-content/60 mt-1">
            Generate a key in Google Cloud Console → enable Pollen API. Free tier: 10K requests/month.
        </p>
    </div>
    <% end %>

    <% :drought -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :drought, fn drought_form -> %>
    <div class="form-control">
        <.input
          field={drought_form[:products]}
          type="select"
          label="Products"
          multiple={true}
          options={[
            {"US Drought Monitor (USDM)", "usdm"},
            {"Coastal Salinity Index — not implemented yet", "csi"},
            {"CPC Outlooks — not implemented yet", "cpc"},
            {"GPCC Drought Index — not implemented yet", "gpcc"}
          ]}
        />
        <p class="text-xs text-base-content/60 mt-1">
            USDM is the only product with live data today. Others are reserved for future implementation.
            Source needs no API key (USDM is a public service).
        </p>
    </div>
    <% end %>

    <% :bourse -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :bourse, fn _b_form -> %>
    <div class="form-control">
        <p class="text-sm text-base-content/70">
            Nothing to configure &mdash; quotes come from Yahoo Finance's public chart endpoint,
            unauthenticated. Add a query per symbol you want to follow.
        </p>
        <p class="text-xs text-base-content/60 mt-1">
            Yahoo publish no official API, so this can change or throttle without notice.
            Quotes refresh every 5 minutes.
        </p>
    </div>
    <% end %>

    <% :treasury -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :treasury, fn t_form -> %>
    <div class="form-control">
        <span class="label-text">Show these groups in query dropdowns</span>
        <%!-- Blank entry so unticking everything still submits the key --%>
        <input type="hidden" name={t_form[:categories].name <> "[]"} value="" />
        <div class="flex flex-col gap-1 mt-1">
            <%= for {value, label} <- [{"currency", "Currencies"}, {"metal", "Metals"}, {"crypto", "Crypto"}] do %>
            <label class="label cursor-pointer justify-start gap-3 py-1">
                <input
                    type="checkbox"
                    class="checkbox checkbox-sm"
                    name={t_form[:categories].name <> "[]"}
                    value={value}
                    checked={value in ((t_form[:categories].value || []) |> List.wrap() |> Enum.map(&to_string/1))}
                />
                <span class="label-text"><%= label %></span>
            </label>
            <% end %>
        </div>
        <p class="text-xs text-base-content/60 mt-1">
            The API carries 186 currencies, 4 metals and 148 crypto tokens. Untick what you
            will not use to keep the query pickers short &mdash; leaving all unticked shows everything.
            Existing queries keep working either way.
        </p>
        <p class="text-xs text-base-content/60 mt-1">
            Data from
            <a href="https://github.com/fawazahmed0/exchange-api" class="link" target="_blank">fawazahmed0/exchange-api</a>,
            updated daily. No key required.
        </p>
    </div>
    <% end %>

    <% :mailbox -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :mailbox, fn mb_form -> %>
    <div class="form-control">
        <.input field={mb_form[:host]} type="text" label="IMAP host (e.g. imap.fastmail.com)"/>
    </div>
    <div class="form-control">
        <.input field={mb_form[:port]} type="number" label="Port"/>
    </div>
    <div class="form-control">
        <.input field={mb_form[:username]} type="text" label="Username"/>
    </div>
    <div class="form-control">
        <.input field={mb_form[:password]} type="password" label="Password" value=""
                placeholder={if @action == :edit, do: "unchanged", else: nil}/>
    </div>
    <div class="form-control">
        <.input field={mb_form[:folder]} type="text" label="Folder"/>
    </div>
    <div class="form-control">
        <.input field={mb_form[:tls]} type="checkbox" label="Use TLS (off means plaintext on 143; STARTTLS is not supported)"/>
    </div>
    <div class="form-control mt-2">
        <button type="button" class="btn btn-sm" phx-click="test-mailbox" phx-target={@myself}>
            <i class="fa-solid fa-plug mr-1"></i> Test connection
        </button>
        <%= if assigns[:mailbox_test] do %>
        <div class={"alert mt-2 py-2 text-sm #{if elem(@mailbox_test, 0) == :ok, do: "alert-success", else: "alert-error"}"}>
            <%= elem(@mailbox_test, 1) %>
        </div>
        <% end %>
        <p class="text-xs text-base-content/60 mt-1">
            Most providers require an app-specific password rather than your account password.
            Point a Packages offering at this mailbox to do something with the mail.
        </p>
    </div>
    <% end %>

    <% :packages -> %>
    <%= polymorphic_embed_inputs_for @form, :config, :packages, fn packages_form -> %>
    <div class="form-control">
        <.input field={packages_form[:mailbox_source_id]} type="select" label="Mailbox"
                options={[{"None - SMTP delivery only", nil} | @mailbox_sel]} />
        <p class="text-xs text-base-content/60 mt-1">
            Which Mailbox offering to pull parcel mail from. Create one of type Mailbox first.
        </p>
    </div>
    <div class="form-control">
        <.input field={packages_form[:apikey_ups_id]} type="text" label="UPS OAuth ID"/>
    </div>
    <div class="form-control">
        <.input field={packages_form[:apikey_ups_secret]} type="text" label="UPS OAuth Secret"/>
    </div>
    <div class="form-control">
        <.input field={packages_form[:apikey_fedex_id]} type="text" label="Fedex OAuth ID"/>
    </div>
    <div class="form-control">
        <.input field={packages_form[:apikey_fedex_secret]} type="text" label="Fedex OAuth Secret"/>
    </div>
    <div class="form-control">
        <.input field={packages_form[:apikey_usps_id]} type="text" label="USPS Consumer Key"/>
    </div>
    <div class="form-control">
        <.input field={packages_form[:apikey_usps_secret]} type="text" label="USPS Consumer Secret"/>
        <p class="text-xs text-base-content/60 mt-1">
            USPS grants the <code>tracking</code> scope separately from app creation - a key that
            mints a token fine can still 401 on every lookup until that is approved.
        </p>
    </div>
    <div class="form-control">
        <.input field={packages_form[:apikey_dhl_id]} type="text" label="DHL OAuth ID"/>
    </div>
    <div class="form-control">
        <.input field={packages_form[:apikey_dhl_secret]} type="text" label="DHL OAuth Secret"/>
    </div>
    <div class="form-control">
        <.input field={packages_form[:apikey_uniuni]} type="text" label="API Key UniUni"/>
    </div>
    <div class="form-control">
        <.input field={packages_form[:handle_usps]} type="checkbox" label="Handle USPS"/>
    </div>
    <% end %>

    <% _ -> %>
    <span class="text-xs">Pick an offering type above</span>
    <% end %>

    <div>
        <%= submit "Save", phx_disable_with: "Saving...", class: "btn btn-secondary" %>
    </div>
</.simple_form>
</div>
