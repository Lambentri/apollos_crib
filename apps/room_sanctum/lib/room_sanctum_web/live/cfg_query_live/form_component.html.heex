<div>
  <h2 class="text-2xl font-bold text-accent"><%= @title %></h2>

  <.simple_form
    for={@form}
    id="query-form"
    phx-target={@myself}
    phx-change="validate"
    phx-submit="save">

  <div class="flex">
    <div class="w-3/4">
      <div class="form-control">
        <.input field={@form[:source_id]} type="select" label="Offering"  options={@cfg_sources_sel}/>
      </div>

      <div class="form-control">
        <.input field={@form[:name]} type="text" label="Name"/>
      </div>

      <div class="form-control">
        <.input field={@form[:notes]} type="text" label="Notes"/>
      </div>
    </div>
    <div class="w-1/4">
      <.inputs_for :let={meta_nested} field={@form[:meta]}>
      <div class="form-control m-10">
          <span class="bg-amber-500"></span>
          <span class="bg-lime-500"></span>
          <span class="bg-emerald-500"></span>
          <span class="bg-sky-500"></span>
          <span class="bg-violet-500"></span>
          <span class="bg-fuchsia-500"></span>
          <span class="bg-rose-500"></span>
          <span class="bg-stone-500"></span>
          <span class="bg-slate-500"></span>
          <span class="bg-stone-950"></span>
          <.input field={meta_nested[:tint]} type="hidden" label="Tint"/>
          <.input field={meta_nested[:tint]} type="radio" label="Tint" options={@tint_opts} prompt="color this" checked_value={meta_nested.params["tint"]} />
      </div>
      </.inputs_for>
    </div>
  </div>
  <div class="flex">
    <div class="w-full">
  <%= case @current_type do %>
  <%= :aqi -> %>
  <%= polymorphic_embed_inputs_for @form, :query, :aqi, fn aqi_form -> %>
  <div class="form-control">
    <.input field={aqi_form[:foci_id]} type="select" label="Foci"  options={@cfg_foci_sel}/>
  </div>
  <% end %>

  <% :calendar -> %>
  <%= polymorphic_embed_inputs_for @form, :query, :calendar, fn cal_form -> %>
  <div class="form-control">
    <.input field={cal_form[:days]} type="number" label="Max Days to Get" />
  </div>
  <div class="form-control">
    <.input field={cal_form[:limit]} type="number" label="Max Events" />
  </div>
  <div class="form-control">
    <.input field={cal_form[:foci_id]} type="select" label="Foci"  options={@cfg_foci_sel} />
  </div>
  <% end %>

  <% :ephem -> %>
  <%= polymorphic_embed_inputs_for @form, :query, :ephem, fn ephem_form -> %>
  <div class="form-control">
    <.input field={ephem_form[:foci_id]} type="select" label="Foci"  options={@cfg_foci_sel} />
  </div>
  <% end %>

  <% :gbfs -> %>
  <%= polymorphic_embed_inputs_for @form, :query, :gbfs, fn gbfs_form -> %>
  <div class="form-control">
    <.input field={gbfs_form[:mode]} type="select" label="Mode"
            options={[{"Station - one dock", "station"}, {"Area - loose bikes around a Foci", "area"}]} />
  </div>

  <div class="divider">Station mode</div>
  <div class="form-control">
    <.input field={gbfs_form[:stop_id]} type="text" label="Stop Id" />
  </div>
  <.search_input field={gbfs_form[:stop_id]} id="search-2" type="gbfs" label="Station Search" results={@results} label_field={:name} value_field={:station_id} />

  <div class="divider">Area mode</div>
  <div class="form-control">
    <.input field={gbfs_form[:foci_id]} type="select" label="Foci" options={@cfg_foci_sel} />
  </div>
  <div class="form-control">
    <.input field={gbfs_form[:radius]} type="number" label="Radius (metres, 50-5000)" />
    <p class="text-xs text-base-content/60 mt-1">
      For a dockless system, which has no station to name. Bikes come back nearest first.
    </p>
  </div>
  <div class="form-control">
    <.input field={gbfs_form[:include_docks]} type="checkbox" label="Include the docks in the radius" />
    <p class="text-xs text-base-content/60 mt-1">
      On a system with both, answers with the stations inside the radius as well as the loose
      bikes - the same shape a station query answers with, so they read the same everywhere.
    </p>
  </div>
  <% end %>

  <% :gtfs -> %>
  <%= polymorphic_embed_inputs_for @form, :query, :gtfs, fn gtfs_form -> %>
  <div class="form-control">
    <.input field={gtfs_form[:stop]} type="text" label="Stop" />
  </div>
  <div class="form-control">
    <.input field={gtfs_form[:routes]} type="text" label="Route Filter" />
  </div>
  <.search_input field={gtfs_form[:stop]} id="search-1" type="gtfs" label="Stop Search" results={@results} label_field={:stop_name} value_field={:stop_id} />
  <% end %>

  <% :hass -> %>
  <%= polymorphic_embed_inputs_for @form, :query, :hass, fn hass_form -> %>
  <div class="form-control">
    <.input field={hass_form[:entity]} type="text" label="Entity" />
  </div>

  <div class="form-control">
    <.input field={hass_form[:properties]} type="text" label="Entity" />
  </div>
  <% end %>

  <% :rideshare -> %>
  <%= polymorphic_embed_inputs_for @form, :query, :rideshare, fn rs_form -> %>
  <div class="provider-inputs">
    <.input field={rs_form[:provider]} type="text" label="Provider" />
    TODOTODOTODO
  </div>
  <div class="api-key-inputs">
    <.input field={rs_form[:api_key]} type="text" label="API Key" />
  </div>
  <% end %>

  <% :tidal -> %>
  <%= polymorphic_embed_inputs_for @form, :query, :tidal, fn tidal_form -> %>
  <div class="form-control">
    <.input field={tidal_form[:station_id]} type="text" label="Station ID" />
  </div>
  <% end %>

  <% :weather -> %>
  <%= polymorphic_embed_inputs_for @form, :query, :weather, fn weather_form -> %>
  <div class="form-control">
    <.input field={weather_form[:foci_id]} type="select" label="Foci"  options={@cfg_foci_sel} />
  </div>
  <% end %>

  <% :cronos -> %>
    <%= polymorphic_embed_inputs_for @form, :query, :cronos, fn cronos_form -> %>
    <div class="form-control">
      <.input field={cronos_form[:mode]} type="select" label="Mode"
              options={[{"Modulo - is now an even multiple of a period", "modulo"},
                        {"Countdown - time until or since a date", "countdown"}]} />
    </div>

    <div class="divider">Countdown mode</div>
    <div class="form-control">
      <.input field={cronos_form[:target]} type="datetime-local" label="Target date and time (local to the Foci)" />
    </div>
    <div class="form-control">
      <.input field={cronos_form[:annual]} type="checkbox" label="Repeats yearly - roll to next year once it passes" />
      <p class="text-xs text-base-content/60 mt-1">
        Without this, the query counts up once the date is behind you. With it, the moment the date
        passes it re-targets the same day next year and starts counting down again.
        A 29 February target falls back to the 28th in non-leap years.
      </p>
    </div>

    <div class="divider">Modulo mode</div>
    <div class="form-control">
      <.input field={cronos_form[:modulo]} type="number" label="Modulo" />
    </div>
      <div class="form-control">
        <.input field={cronos_form[:offset]} type="number" label="Offset" />
      </div>
      <div class="form-control">
        <.input field={cronos_form[:period]} type="select" label="Period" options={[:minute, :hour, :day, :week, :month]} />
      </div>
      <div class="form-control">
        <.input field={cronos_form[:foci_id]} type="select" label="Foci" options={@cfg_foci_sel} />
      </div>
    <% end %>

  <% :gitlab -> %>
      <%= polymorphic_embed_inputs_for @form, :query, :gitlab, fn gitlab_form -> %>
      <div class="form-control">
        <.input field={gitlab_form[:id]} type="number" label="Project ID (leave blank if using Namespace)" />
      </div>
      <div class="form-control">
        <.input field={gitlab_form[:namespace]} type="text" label="Namespace full_path (leave blank if using Project ID)" />
      </div>
      <div class="form-control">
        <.input field={gitlab_form[:statuses]} type="text" label="Statuses (comma list, e.g. running,pending; blank = all)" />
      </div>
      <% end %>

  <% :github -> %>
      <%= polymorphic_embed_inputs_for @form, :query, :github, fn gh_form -> %>
      <div class="form-control">
        <.input field={gh_form[:repo]} type="text" label="Repo (owner/name) - leave blank if using Owner" />
      </div>
      <div class="form-control">
        <.input field={gh_form[:owner]} type="text" label="Owner (org/user) - leave blank if using Repo" />
      </div>
      <div class="form-control">
        <.input field={gh_form[:level]} type="select" label="Level" options={["runs", "jobs"]} />
      </div>
      <div class="form-control">
        <.input field={gh_form[:status]} type="text" label="Status (comma list: queued,in_progress,completed; blank = all)" />
      </div>
      <div class="form-control">
        <.input field={gh_form[:conclusion]} type="text" label="Conclusion (comma list: success,failure,cancelled,skipped; blank = all)" />
      </div>
      <% end %>
    <% :bourse -> %>
      <%= polymorphic_embed_inputs_for @form, :query, :bourse, fn b_form -> %>
      <div class="form-control">
        <.input field={b_form[:symbol]} type="text" label="Ticker symbol" />
        <p class="text-xs text-base-content/60 mt-1">
          Yahoo notation: <code>AAPL</code>, <code>VOO</code>, <code>^GSPC</code> for an index,
          <code>BTC-USD</code> for crypto, <code>TSCO.L</code> for a London listing.
        </p>
      </div>
      <% end %>

    <% :treasury -> %>
      <%= polymorphic_embed_inputs_for @form, :query, :treasury, fn t_form -> %>
      <div class="form-control">
        <.input field={t_form[:from]} type="select" label="From (base)"
                prompt="Pick a currency" options={@treasury_groups} />
      </div>
      <div class="flex justify-center -my-1">
        <button type="button" class="btn btn-sm btn-circle btn-ghost"
                phx-click="treasury-swap" phx-target={@myself} title="Swap base and quote">
          <i class="fa-solid fa-arrow-right-arrow-left fa-rotate-90"></i>
        </button>
      </div>
      <div class="form-control">
        <.input field={t_form[:to]} type="select" label="To (quote)"
                prompt="Pick a currency" options={@treasury_groups} />
      </div>
      <div class="form-control">
        <.input field={t_form[:precision]} type="number" label="Decimal places (0-10)" />
        <p class="text-xs text-base-content/60 mt-1">
          Swap if the number reads the wrong way round &mdash; 0.0000116 usually means you
          wanted the reciprocal. Rates below 1 keep this many significant digits rather than
          decimals, so a BTC pair stays readable.
        </p>
      </div>
      <% end %>

    <% :mailbox -> %>
      <%= polymorphic_embed_inputs_for @form, :query, :mailbox, fn mb_form -> %>
      <div class="form-control">
        <.input field={mb_form[:count]} type="number" label="How many messages (1-100)" />
      </div>
      <div class="form-control">
        <.input field={mb_form[:unread_only]} type="checkbox" label="Unread only" />
      </div>
      <p class="text-xs text-base-content/60">
        Read-only - listing a mailbox never marks anything as read.
      </p>
      <% end %>

    <% :icarus -> %>
      <%= polymorphic_embed_inputs_for @form, :query, :icarus, fn icarus_form -> %>
      <div class="form-control">
        <.input field={icarus_form[:mode]} type="select" label="Mode"
                options={[{"Area - everything overhead a Foci", "area"}, {"Flight - track one arrival until it lands", "flight"}]} />
      </div>

      <div class="divider">Area mode</div>
      <div class="form-control">
        <.input field={icarus_form[:foci_id]} type="select" label="Foci" options={@cfg_foci_sel} />
      </div>
      <div class="form-control">
        <.input field={icarus_form[:dist]} type="number" label="Radius (nautical miles, 1-250)" />
      </div>
      <div class="form-control">
        <.input field={icarus_form[:alt_min]} type="number" label="Altitude floor (ft, blank for none - a floor also hides aircraft on the ground)" />
      </div>
      <div class="form-control">
        <.input field={icarus_form[:alt_max]} type="number" label="Altitude ceiling (ft, blank for none)" />
      </div>
      <div class="form-control">
        <.input
          field={icarus_form[:classes]}
          type="select"
          label="Show which traffic"
          multiple={true}
          options={[
            {"Commercial - scheduled passenger airlines", "commercial"},
            {"Cargo - dedicated freight operators", "cargo"},
            {"Military", "military"},
            {"General - private, business, everything else", "general"}
          ]}
        />
        <p class="text-xs text-base-content/60 mt-1">
          Select none to show everything. Military comes from the feed's own flag; cargo and
          commercial are inferred from the operator callsign, so belly freight on a passenger
          flight counts as commercial and an unlisted carrier falls under general.
        </p>
      </div>

      <div class="form-control">
        <.input field={icarus_form[:limit]} type="number" label="Most aircraft to show (blank for no limit)" />
        <p class="text-xs text-base-content/60 mt-1">
          Applied after the filters above, to the nearest aircraft first - a limit of 5 shows the
          five closest that match, not the first five the feed happened to return.
        </p>
      </div>

      <div class="divider">Flight mode</div>
      <div class="form-control">
        <.input field={icarus_form[:flight_number]} type="text" label="Flight number (e.g. UA 558)" />
        <p class="text-xs text-base-content/60 mt-1">
          Aircraft transmit the ICAO callsign, so UA 558 is matched as UAL558. If your airline
          is not recognised, enter the ICAO callsign directly.
        </p>
      </div>
      <div class="form-control">
        <.input field={icarus_form[:dest]} type="text" label="Destination airport (IATA or ICAO, e.g. BOS)" />
      </div>
      <div class="form-control">
        <.input field={icarus_form[:sched_arrival]} type="datetime-local" label="Scheduled arrival (from the ticket, in your local time)" />
        <p class="text-xs text-base-content/60 mt-1">
          This is what early / on time / delayed is measured against - adsb.fi has no schedule data.
        </p>
      </div>
      <div class="form-control">
        <.input field={icarus_form[:sched_departure]} type="datetime-local" label="Scheduled departure (optional)" />
      </div>
      <div class="form-control">
        <.input field={icarus_form[:curb_minutes]} type="number" label="Taxi + bags padding (minutes after touchdown)" />
      </div>
      <% end %>

    <% :pollen -> %>
      <%= polymorphic_embed_inputs_for @form, :query, :pollen, fn pollen_form -> %>
      <div class="form-control">
        <.input field={pollen_form[:foci_id]} type="select" label="Foci" options={@cfg_foci_sel} />
      </div>
      <div class="form-control">
        <.input field={pollen_form[:days]} type="number" label="Forecast days (1–5)" />
      </div>
      <% end %>

  <% :drought -> %>
      <%= polymorphic_embed_inputs_for @form, :query, :drought, fn drought_form -> %>
      <div class="form-control">
        <.input field={drought_form[:product]} type="select" label="Product" options={[{"USDM (US Drought Monitor)", "usdm"}, {"CSI (not implemented)", "csi"}, {"CPC outlooks (not implemented)", "cpc"}, {"GPCC (not implemented)", "gpcc"}]} />
      </div>
      <div class="form-control">
        <.input field={drought_form[:fips]} type="text" label="FIPS county code (5 digits, e.g. 25025) — leave blank if using State" />
      </div>
      <div class="form-control">
        <.input field={drought_form[:state]} type="text" label="State (2-letter, e.g. MA) — leave blank if using FIPS" />
      </div>
      <% end %>

  <% :packages -> %>
      <%= polymorphic_embed_inputs_for @form, :query, :packages, fn packages_form -> %>
      <div class="form-control">
        <.input field={packages_form[:show_delivered_for]} type="number" label="Show delivered packages for X days" />
      </div>
      <div class="form-control">
        <.input field={packages_form[:carriers]} type="select" multiple="true" label="Carriers" prompt={nil} options={[:ups, :fedex, :usps, :uniuni]} />
      </div>
      <% end %>
  <% _ -> %>
    <span class="text-xs">Pick an offering above</span>
  <% end %>
    </div>
  </div>
    <div>
      <%= submit "Save", phx_disable_with: "Saving...", class: "btn btn-secondary" %>
    </div>
  </.simple_form>
</div>
