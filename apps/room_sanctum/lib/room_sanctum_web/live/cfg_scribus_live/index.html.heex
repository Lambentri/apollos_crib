<.itb icon="fa-plus" to={Routes.scribus_index_path(@socket, :new)} what="Scribus"></.itb>
<h1 class="text-3xl font-bold text-accent mx-4 bg-secondary-300 py-2">Available Scribus <i class="fa-regular fa-circle-question fa-xs" phx-click="info"></i></h1>

<%= if @show_info do %>
<div class="card card-compact w-full bg-base-100 shadow-xl mx-6 my-2">
  <div class="card-body">
    <h3 class="card-title italic">Scribus:</h3>
    <p>A parcel containing how we want the scribes to do their work.</p>
  </div>
</div>
<% end %>

<.table
  id="cfg_scribus"
  rows={@streams.cfg_scribus}
  class="table table-compact w-full mx-6"
  row_click={fn {_id, scribus} -> JS.navigate(~p"/cfg/scribus/#{scribus}") end}
>
  <:col :let={{_id, scribus}} label="Name"><%= scribus.name %></:col>
  <:col :let={{_id, scribus}} label="Resolution"><%= scribus.resolution %></:col>
  <:col :let={{_id, scribus}} label="Configuration"><%= scribus.configuration %></:col>
  <:action :let={{_id, scribus}}>
    <div class="sr-only">
      <.link navigate={~p"/cfg/scribus/#{scribus}"}>Show</.link>
    </div>
    <.link patch={~p"/cfg/scribus/#{scribus}/edit"}>Edit</.link>
  </:action>
  <:action :let={{id, scribus}}>
    <.link
      phx-click={JS.push("delete", value: %{id: scribus.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>

<.modal :if={@live_action in [:new, :edit]} id="scribus-modal" show on_cancel={JS.patch(~p"/cfg/scribus")}>
  <.live_component
    module={RoomSanctumWeb.ScribusLive.FormComponent}
    id={@scribus.id || :new}
    title={@page_title}
    action={@live_action}
    scribus={@scribus}
    patch={~p"/cfg/scribus"}
    current_user={@current_user}
  />
</.modal>

<div class="card card-compact w-full bg-base-100 shadow-xl mx-6 my-4">
  <div class="card-body">
    <div class="flex items-center justify-between">
      <h3 class="card-title">Resolutions</h3>
      <button type="button" phx-click="refresh-resolutions" class="btn btn-ghost btn-sm" title="Refresh">
        <i class="fas fa-fw fa-rotate"></i>
      </button>
    </div>
    <p class="text-sm opacity-70">
      The browser-ctl snappers running in the cluster. A Scribus can use any that is Ready.
      Ones marked <span class="badge badge-sm badge-ghost">git</span> are set in the MutantDeployment manifest and change there.
    </p>

    <div :if={@resolutions_error} class="alert alert-warning text-sm">
      <i class="fas fa-fw fa-triangle-exclamation"></i> Resolutions unavailable: <%= @resolutions_error %>
    </div>

    <table class="table table-compact w-full">
      <thead>
        <tr>
          <th>Name</th>
          <th>Resolution</th>
          <th>Snappers</th>
          <th>State</th>
          <th :if={@admin?}></th>
        </tr>
      </thead>
      <tbody id="resolutions">
        <tr :for={r <- @resolutions} id={"resolution-#{r.label}"}>
          <td>
            <%= r.label %>
            <span :if={r.source == :inline} class="badge badge-sm badge-ghost">git</span>
          </td>
          <td><%= r.resolution %></td>
          <td><%= r.ready %>/<%= r.instances %></td>
          <td>
            <span class={[
              "badge badge-sm",
              r.state == "Ready" && "badge-success",
              r.state == "Progressing" && "badge-info",
              r.state not in ["Ready", "Progressing"] && "badge-error"
            ]}>
              <%= r.state %>
            </span>
          </td>
          <td :if={@admin?}>
            <.link
              :if={r.source == :resource}
              phx-click={JS.push("delete-resolution", value: %{label: r.label})}
              data-confirm={"Stop the #{r.resolution} snappers? Any Scribus using it stops updating."}
              class="text-error"
            >
              <i class="fas fa-fw fa-trash"></i>
            </.link>
          </td>
        </tr>
      </tbody>
    </table>

    <.form :if={@admin?} for={@resolution_form} phx-submit="add-resolution" class="flex gap-2 items-end mt-2">
      <.input field={@resolution_form[:name]} type="text" label="Name" placeholder="InkPad 5" />
      <.input field={@resolution_form[:width]} type="number" label="Width" min="1" />
      <.input field={@resolution_form[:height]} type="number" label="Height" min="1" />
      <.input field={@resolution_form[:instances]} type="number" label="Snappers" min="1" />
      <button type="submit" class="btn btn-secondary btn-sm">
        <i class="fas fa-fw fa-plus"></i> Start
      </button>
    </.form>
  </div>
</div>
