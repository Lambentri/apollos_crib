<.itb icon="fa-chevron-left" to={Routes.vision_index_path(@socket, :index)} what="Back"></.itb>
<.itb icon="fa-pencil" to={Routes.vision_show_path(@socket, :edit, @vision)} what="Edit"></.itb>

<h1 class="text-3xl font-bold text-accent mx-4 py-2">Vision Detail</h1>


<.modal :if={@live_action == :edit} id="vision-modal" show on_cancel={JS.patch(Routes.vision_show_path(@socket, :show, @vision))}>
    <.live_component
      module={RoomSanctumWeb.VisionLive.FormComponent}
      id={@vision.id}
      title={@page_title}
      action={@live_action}
      vision={@vision}
      patch={Routes.vision_show_path(@socket, :show, @vision)}
      current_user={@current_user}
    />
  </.modal>

<div class="mx-4 py-2">
  <div class="flex">
    <h2 class="text-2xl font-bold text-accent-300">
      <.tint_dot tint={@vision.meta && @vision.meta.tint} class="mr-2" />
      <%= @vision.name %>
    </h2>
  </div>
  <div class="flex flex-col flex-col-reverse sm:flex-col-reverse md:flex-col">
          <div class="flex flex-wrap md:flex-nowrap flex-col-reverse md:flex-row">
            <div class="card card-compact w-full md:w-5/6 bg-base-100 shadow-xl m-2">
              <div class="card-body text-left">
                <h3 class="card-title">Queries</h3>
                <p>
                <%= for q <- @queries do %>
                  <%= live_patch to: Routes.query_show_path(@socket, :show, q.id), class: "btn btn-primary gap-2 float-left mx-2 " do %>
                    <%= cond do %>
                    <% q.meta && q.meta.tint && q.source.meta.tint -> %>
                      <!-- Both query and source tints - use fa-stack -->
                      <span class="fa-stack">
                        <i class={"fa-solid fa-circle fa-fw fa-stack-1x z-30 text-#{q.source.meta.tint}-500"}></i>
                        <i class={"fa-solid fa-circle fa-fw z-40 fa-stack-1x text-#{q.meta.tint}-500"} data-fa-transform="shrink-3 right-4"></i>

                      </span>
                    <% q.meta && q.meta.tint -> %>
                      <!-- Query tint only -->
                      <i class={"fa-solid fa-circle-half-stroke fa-spin fa-fw text-#{q.meta.tint}-500"}></i>
                    <% q.source.meta.tint -> %>
                      <!-- Source tint only -->
                      <i class={"fa-solid fa-circle text-#{q.source.meta.tint}-500"}></i>
                    <% true -> %>
                      <!-- No tints -->
                  <% end %>
                    <i class={"fas #{get_icon(q.source.type)}"}></i>&emsp;<%= q.name %>
                  <% end %>
                <% end %>
                </p>
              </div>
            </div>
            <div class="card card-compact w-full md:w-1/6 bg-base-100 shadow-xl m-2">
              <div class="card-body text-left">
                <h3 class="card-title flex justify-between">
                  Pythiae
                  <%!-- Shown even with nothing to add to: that is when you want
                        to make a pythiae, not when you are locked out of the
                        panel. --%>
                  <%= if @pythiae_sel do %>
                    <span class="cursor-pointer" phx-click="toggle-pythiae-sel"><i class="fa-solid fa-minus"></i></span>
                  <% else %>
                    <span class="cursor-pointer" phx-click="toggle-pythiae-sel"><i class="fa-solid fa-plus"></i></span>
                  <% end %>
                </h3>
                <%= for q <- @pythiae do %>
                  <div class="flex gap-2 mx-2 my-1">
                    <%= live_patch to: Routes.pythiae_show_path(@socket, :show, q.id), class: "btn btn-primary gap-2 grow" do %>
                      <%= q.name %>
                    <% end %>
                    <%!-- Only while the panel is open, so the usual view of
                          "the pythiae showing this vision" stays a row of
                          plain links. --%>
                    <button
                      :if={@pythiae_sel}
                      type="button"
                      class="btn btn-error btn-square shrink-0"
                      phx-click="remove-from-pythiae"
                      phx-value-pythiae={q.id}
                      title={"Remove from #{q.name}"}
                    >
                      <i class="fa-solid fa-minus"></i>
                    </button>
                  </div>
                <% end %>
                <%= if @pythiae_sel do %>
                  <%= if @avail_pythiae != [] do %>
                    <h4 class="text-xl text-accent font-bold">Add to</h4>
                    <%= for q <- @avail_pythiae do %>
                      <div
                        class="btn btn-secondary gap-2 mx-2 my-1"
                        phx-click="add-to-pythiae"
                        phx-value-pythiae={q.id}
                      >
                        <%= q.name %>
                      </div>
                    <% end %>
                  <% end %>

                  <h4 class="text-xl text-accent font-bold mt-4">Or a new one</h4>
                  <%!-- Named for the vision by default, which is what a screen
                        showing one vision almost always wants to be called --
                        still a text box, for when it is not. --%>
                  <form phx-submit="add-to-new-pythiae" class="flex flex-col gap-2">
                    <input
                      type="text"
                      name="pythiae[name]"
                      value={@vision.name}
                      placeholder={@vision.name}
                      class="input input-bordered input-sm w-full"
                    />
                    <button type="submit" class="btn btn-secondary btn-sm">Create</button>
                  </form>
                <% end %>
              </div>
            </div>
          </div>
          <div class="flex flex-wrap md:flex-nowrap flex-col-reverse md:flex-row">
            <div class="card card-compact w-full md:w-1/2 bg-base-100 shadow-xl m-2">
              <div class="card-body">
                <h3 class="card-title">Vision</h3>
                <table class="table table-compact">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Query</th>
                            <th>Schedule</th>
                        </tr>
                    </thead>
                  <tbody>
                    <%= for q <- @vision.queries |> Enum.sort_by(&{sortert(&1.type), &1.data.order}) do %>
                      <tr>
                        <td><%= q.type %></td>
                        <td>
                          <i class={"fas #{get_query_data_icon(q.data.query, @queries)}"}></i>
                          <%= get_query_data(q.data.query, @queries) %>
                        </td>
                        <td>
                          <%= if q.data |> Map.get(:weekdays) do %>
                          <%= for w <- weekdays() do %>
                          <div class={badge_weekday(w, q.data.weekdays)}><%= w %></div>
                          <% end %>
                          &emsp;
                          <i class="fas fa-clock"></i>
                          <%= q.data.time_start %>
                          <i class="fas fa-arrow-right"></i>
                          <%= q.data.time_end %>
                          <% else %>
                          <div class="badge">N/A</div>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
            <div class="card card-compact w-full md:w-1/2 bg-base-100 shadow-xl m-2">
              <div class="card-body">

                  <div class="flex">
                    <div class="flex-auto basis-4/5">
                      <h3 class="card-title w-full">Preview</h3>
                    </div>
                    <div class="flex-1 w-3/4">
                      &nbsp;
                    </div>
                    <div class="flex-none flex gap-1">
                      <%!-- Raw is a lens over the reading you are on rather than
                            a reading of its own, so it toggles rather than
                            joining the cycle. The map is not a reading of the
                            condensed data, so it has nothing to show raw. --%>
                      <%= if @preview_mode != :map do %>
                        <button
                          class={"btn btn-sm #{if @preview_raw, do: "btn-accent", else: "btn-ghost"}"}
                          phx-click="toggle-preview-raw"
                          title="the condensed data behind this view, as JSON"
                        >
                          <i class="fa-solid fa-code"></i>
                        </button>
                      <% end %>
                      <button class="btn btn-secondary btn-sm" phx-click="toggle-preview-mode"><%= @preview_mode %></button>
                    </div>
                  </div>
                <%= if @preview_raw and @preview_mode != :map do %>
                  <%= for {k, p} <- @preview do %>
                  <div class="flex">
                    <div class="w-16">
                      <i class={"fas fa-fw fa-2xl #{get_icon(k |> elem(1))}"}></i>
                    </div>
                    <div class="w-7/8">
                      <span class="text-secondary font-bold"><%= get_query_data(k |> elem(0), @queries, 64) %></span>
                      <pre><%= condense_for(@preview_mode, k, p) |> Poison.encode!(pretty: true)%></pre>
                    </div>
                  </div>
                  <% end %>
                <% else %>
                <%= case @preview_mode do %>
                <%= :basic -> %>
                  <%= for {k, p} <- @preview do %>
                    <div class="flex gap-2">
                      <i class={"fas fa-fw fa-xl #{get_icon(k |> elem(1))}"}></i>
                      <span class="text-secondary font-bold"><%= get_query_data(k |> elem(0), @queries, 64) %></span>
                    </div>
                    <%= case k do %>
                      <%= {_, :gtfs} -> %> <.p_gtfs entries={condense(k, p) |> preview(k)}> </.p_gtfs>
                      <% {_, :gbfs} -> %> <.p_gbfs entries={condense(k, p) |> preview(k)}> </.p_gbfs>
                      <% {_, :tidal} -> %>  <.p_tidal entries={condense(k, p) |> preview(k)}> </.p_tidal>
                      <% {_, :weather} -> %> <.p_weather entries={condense(k, p) |> preview(k)}> </.p_weather>
                      <% {_, :aqi} -> %> <.p_aqi entries={condense(k, p) |> preview(k)}> </.p_aqi>
                      <% {_, :ephem} -> %> <.p_ephem entries={condense(k, p) |> preview(k)}> </.p_ephem>
                      <% {_, :calendar} -> %> <.p_calendar entries={condense(k, p) |> preview(k)}> </.p_calendar>
                      <% {_, :cronos} -> %> <.p_cronos entries={condense(k, p) |> preview(k)}> </.p_cronos>
                      <% {_, :gitlab} -> %> <.p_gitlab entries={condense(k, p) |> preview(k)}> </.p_gitlab>
                      <% {_, :github} -> %> <.p_github entries={condense(k, p) |> preview(k)}> </.p_github>
                      <% {_, :drought} -> %> <.p_drought entries={condense(k, p) |> preview(k)}> </.p_drought>
                      <% {_, :pollen} -> %> <.p_pollen entries={condense(k, p) |> preview(k)}> </.p_pollen>
                      <% {_, :icarus} -> %> <.p_icarus entries={condense(k, p) |> preview(k)}> </.p_icarus>
                      <% {_, :mailbox} -> %> <.p_mailbox entries={condense(k, p) |> preview(k)}> </.p_mailbox>
                      <% {_, :treasury} -> %> <.p_treasury entries={condense(k, p) |> preview(k)}> </.p_treasury>
                      <% {_, :bourse} -> %> <.p_bourse entries={condense(k, p) |> preview(k)}> </.p_bourse>
                      <% {_, :packages} -> %> <.p_packages entries={condense(k, p) |> preview(k)}> </.p_packages>
                    <% end %>
                  <% end %>
                <% :plus -> %>
                  <%= for {k, p} <- @preview do %>
                    <div class="flex gap-2">
                      <i class={"fas fa-fw fa-xl #{get_icon(k |> elem(1))}"}></i>
                      <span class="text-secondary font-bold"><%= get_query_data(k |> elem(0), @queries, 64) %></span>
                    </div>
                    <.p_plus type={k |> elem(1)} entries={condense_plus(k, p) |> preview(k)} />
                  <% end %>
                <% :map -> %>
                  <%!-- Where this vision's queries are. Anything with a place
                        -- a stop, a dock, a foci -- plots; the rest of the
                        vision is simply not on a map. --%>
                  <%= if @queries == [] do %>
                    <p class="text-sm opacity-60">Nothing to place yet.</p>
                  <% else %>
                    <.query_geospatial_map
                      id="vision-map"
                      queries={@queries}
                      aircraft={@aircraft}
                      free_bikes={@free_bikes}
                      query_summaries={@query_summaries}
                      stations={@stations}
                      station_statuses={@station_statuses}
                      queried_station_ids={@queried_station_ids}
                      vehicle_positions={@vehicle_positions}
                      class=""
                      height="420px"
                      legend={false}
                    />
                  <% end %>
                <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
</div>
