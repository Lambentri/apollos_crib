<.itb icon="fa-chevron-left" to={Routes.plani_index_path(@socket, :index)} what="Back"></.itb>
<.itb icon="fa-pencil" to={Routes.plani_index_path(@socket, :edit, @plani)} what="Edit"></.itb>

<h1 class="text-3xl font-bold text-accent mx-4 py-2"><%= @plani.name %></h1>

<div class="mx-4">
  <%= if @pythiae == [] do %>
    <p class="text-sm opacity-60">
      <i class="fas fa-fw fa-circle-info"></i>
      No Pythiae is showing this. Set it as one's current Plani and it will be
      published instead of that Pythiae's vision.
    </p>
  <% else %>
    <p class="text-sm">
      Showing on
      <%= for p <- @pythiae do %>
        <a href={Routes.pythiae_show_path(@socket, :show, p)} class="btn btn-xs btn-secondary gap-1">
          <i class="fas fa-fw fa-tower-broadcast"></i> <%= p.name %>
        </a>
      <% end %>
    </p>
  <% end %>
</div>

<div class="mx-4 py-2">
  <div class="card card-compact w-full bg-base-100 shadow-xl">
    <div class="card-body">
      <h3 class="card-title">
        <i class="fas fa-fw fa-map-location-dot"></i> What is around it
      </h3>
      <p class="text-sm opacity-70">
        The anchor and everything found near it. The map follows the anchor, so
        a client that is moving redraws this as it goes.
      </p>
      <.query_geospatial_map
        id="plani-map"
        queries={[]}
        height="420px"
        focus={RoomSanctumWeb.PlaniLive.Show.focus(@anchor)}
        focus_zoom={15}
        route_lines={RoomSanctumWeb.PlaniLive.Show.radius_ring(@anchor, @plani.radius)}
        show_route_lines={true}
        stations={RoomSanctumWeb.PlaniLive.Show.markers(@anchor, :stations)}
        free_bikes={RoomSanctumWeb.PlaniLive.Show.markers(@anchor, :bikes)}
        legend={false}
      />
    </div>
  </div>
</div>

<div class="mx-4 py-2">
  <div class="card card-compact w-full bg-base-100 shadow-xl">
    <div class="card-body">
      <div class="flex items-center justify-between gap-2 flex-wrap">
        <h3 class="card-title"><i class="fas fa-fw fa-eye"></i> What it is publishing</h3>
        <%!-- Basic is what the clients actually receive, so it leads and is
              the default; Plus is the same data read further, for the types
              that carry more than a card has room for. --%>
        <div class="join">
          <button
            class={"btn btn-xs join-item #{if @view == :basic, do: "btn-primary", else: "btn-ghost"}"}
            phx-click="view"
            phx-value-view="basic"
          >
            Basic
          </button>
          <button
            class={"btn btn-xs join-item #{if @view == :plus, do: "btn-primary", else: "btn-ghost"}"}
            phx-click="view"
            phx-value-view="plus"
          >
            Plus
          </button>
        </div>
      </div>
      <% entries = RoomSanctumWeb.PlaniLive.Show.entries(@state) %>
      <%= if entries == [] do %>
        <p class="opacity-70">
          Nothing yet. A Plani asks its sources every half minute, and publishes
          whatever came back.
        </p>
      <% else %>
        <p class="text-xs opacity-60">
          Condensed as it goes on the wire, so this is what a client draws —
          <%= if @plani.break_out do %>
            one card per stop.
          <% else %>
            one card per source, with the stops near you blended into it.
          <% end %>
        </p>
        <div class="2xl:columns-4 xl:columns-3 lg:columns-2 gap-4 mt-2">
          <div :for={{key, rows} <- entries} class="card bg-base-300 shadow-xl mb-2 break-inside-avoid">
            <div class="card-body">
              <div class="flex gap-2">
                <i class={"fas fa-fw fa-xl #{RoomSanctumWeb.IconHelpers.icon(elem(key, 1))}"}></i>
                <span class="text-secondary font-bold">
                  <%= RoomSanctumWeb.PlaniLive.Show.entry_name(@state, elem(key, 0)) %>
                </span>
              </div>
              <%!-- Dispatched rather than listed here: a case written out on
                    the page falls through to nothing for every type added
                    after it, which is how weather and the rest ended up
                    rendering as `inspect` on this page. --%>
              <%= if @view == :plus do %>
                <.p_plus
                  type={elem(key, 1)}
                  entries={RoomSanctumWeb.PlaniLive.Show.condensed(key, rows, :plus)}
                />
              <% else %>
                <.p_basic
                  type={elem(key, 1)}
                  entries={RoomSanctumWeb.PlaniLive.Show.condensed(key, rows)}
                />
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%!-- A grid rather than flex-wrap: these were already md:w-1/2, but the m-2
      beside it made each half a full rem wider than half, so the pair never
      fitted on one row and silently stacked. A gap belongs to the container. --%>
<div class="mx-4 py-2 grid gap-4 md:grid-cols-2 items-start">
  <div class="card card-compact w-full bg-base-100 shadow-xl">
    <div class="card-body">
      <h3 class="card-title">
        <i class="fas fa-fw fa-location-crosshairs"></i> Where it is
      </h3>

      <%= case @anchor do %>
        <% nil -> %>
          <p class="opacity-70">
            No worker yet — one is started within a few seconds of a Plani being made.
          </p>
        <% %{anchored_to: :client} = a -> %>
          <p>
            <span class="badge badge-success gap-2">
              <i class="fas fa-fw fa-satellite-dish"></i> following a client
            </span>
          </p>
          <pre class="text-sm"><%= RoomSanctumWeb.PlaniLive.Show.coordinates(a) %></pre>
        <% a -> %>
          <p>
            <span class="badge badge-ghost gap-2">
              <i class="fas fa-fw fa-house"></i> at home
            </span>
          </p>
          <pre class="text-sm"><%= RoomSanctumWeb.PlaniLive.Show.coordinates(a) %></pre>
          <p class="text-xs opacity-60">
            Nothing has reported inside the window, so the home foci is answering.
          </p>
      <% end %>
    </div>
  </div>

  <div class="card card-compact w-full bg-base-100 shadow-xl">
    <div class="card-body">
      <h3 class="card-title"><i class="fas fa-fw fa-layer-group"></i> What it is asking</h3>
      <% asked = RoomSanctumWeb.PlaniLive.Show.asked(@plani, @sources) %>
      <%= if asked == [] do %>
        <p class="opacity-70">No sources yet. Edit it to add some, or follow a tint.</p>
      <% else %>
        <%= if @plani.follow_tint do %>
          <p class="text-sm mb-1">
            <.tint_dot tint={@plani.follow_tint} /> following everything tinted
            <span class="font-mono"><%= @plani.follow_tint %></span>
          </p>
        <% end %>
        <div class="flex flex-col gap-1">
          <div
            :for={source <- asked}
            class="flex items-center gap-2 rounded-lg bg-base-200 px-3 py-2"
          >
            <.tint_dot tint={source.meta && source.meta.tint} />
            <i class={"fas fa-fw #{RoomSanctumWeb.IconHelpers.icon(source.type)}"}></i>
            <a href={Routes.source_show_path(@socket, :show, source)} class="hover:underline">
              <%= source.name %>
            </a>
            <span class="ml-auto">
              <%= case RoomSanctumWeb.PlaniLive.Show.outcome(@anchor, source.id) do %>
                <% {:ok, n} -> %>
                  <span class="badge badge-accent"><%= n %></span>
                <% {:empty, why} -> %>
                  <span class="badge badge-ghost" title={why}>none</span>
                <% {:skipped, why} -> %>
                  <span class="badge badge-warning gap-1" title={why}>
                    <i class="fas fa-fw fa-ban text-xs"></i> skipped
                  </span>
                <% {:error, message} -> %>
                  <span class="badge badge-error gap-1" title={message}>
                    <i class="fas fa-fw fa-triangle-exclamation text-xs"></i> failed
                  </span>
                <% {:pending, why} -> %>
                  <span class="badge badge-ghost" title={why}>waiting</span>
              <% end %>
            </span>
          </div>
        </div>
        <p class="text-xs opacity-60">
          Within <%= @plani.radius %>m, up to <%= @plani.limit %> of each. A source with
          nothing located in it is skipped rather than guessed at.
        </p>
      <% end %>
    </div>
  </div>
</div>

<div class="mx-4 py-2">
  <%!-- Collapsed by default, and with a checkbox rather than an event: this is
        a reference the reader opens once to check a number, not state the
        server has any business remembering. --%>
  <div class="collapse collapse-arrow bg-base-100 shadow-xl">
    <input type="checkbox" />
    <div class="collapse-title card-title text-base">
      <i class="fas fa-fw fa-sliders"></i> How it is set up
    </div>
    <div class="collapse-content">
      <div class="grid gap-x-6 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
        <div
          :for={{label, kind, value} <- RoomSanctumWeb.PlaniLive.Show.settings(@plani)}
          class="flex items-center justify-between gap-2 border-b border-base-300 py-1"
        >
          <span class="text-sm opacity-70"><%= label %></span>
          <%= case {kind, value} do %>
            <% {:flag, true} -> %>
              <span class="badge badge-accent badge-sm gap-1">
                <i class="fas fa-fw fa-check text-xs"></i> on
              </span>
            <% {:flag, _} -> %>
              <span class="badge badge-ghost badge-sm">off</span>
            <% {_, nil} -> %>
              <span class="text-sm opacity-40">not set</span>
            <% {_, ""} -> %>
              <span class="text-sm opacity-40">not set</span>
            <% {_, shown} -> %>
              <span class="font-mono text-sm"><%= shown %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
