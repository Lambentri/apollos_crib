<.itb icon="fa-plus" to={Routes.plani_index_path(@socket, :new)} what="New Plani"></.itb>

<h1 class="text-3xl font-bold text-accent mx-4 py-2">Plani</h1>

<p class="mx-4 text-sm opacity-70">
  A vision whose anchor moves. Where a vision asks its queries in the places they
  name, a Plani asks its sources around wherever its client currently is — and
  around its home foci when none is reporting.
</p>

<.modal
  :if={@live_action in [:new, :edit]}
  id="plani-modal"
  show
  on_cancel={JS.patch(Routes.plani_index_path(@socket, :index))}
>
  <.live_component
    module={RoomSanctumWeb.PlaniLive.FormComponent}
    id={@plani.id || :new}
    title={@page_title}
    action={@live_action}
    plani={@plani}
    patch={Routes.plani_index_path(@socket, :index)}
    current_user={@current_user}
  />
</.modal>

<div class="mx-4 py-2 flex flex-wrap gap-2">
  <div :for={{id, plani} <- @streams.plani} id={id} class="card card-compact w-full md:w-1/3 bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">
        <a href={Routes.plani_show_path(@socket, :show, plani)} class="hover:underline">
          <%= plani.name %>
        </a>
      </h2>
      <p class="text-sm opacity-70">
        <i class="fas fa-fw fa-layer-group"></i>
        <%= length(plani.sources) %> source<%= if length(plani.sources) == 1, do: "", else: "s" %>
        · <%= plani.radius %>m · <%= plani.limit %> each
      </p>
      <div class="card-actions justify-end">
        <.link patch={Routes.plani_index_path(@socket, :edit, plani)} class="btn btn-sm btn-secondary">
          <i class="fas fa-fw fa-pencil"></i>
        </.link>
        <.link
          phx-click={JS.push("delete", value: %{id: plani.id})}
          data-confirm="Delete this Plani?"
          class="btn btn-sm btn-error"
        >
          <i class="fas fa-fw fa-trash"></i>
        </.link>
      </div>
    </div>
  </div>
</div>
