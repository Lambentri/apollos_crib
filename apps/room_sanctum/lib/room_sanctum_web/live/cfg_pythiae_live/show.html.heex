<.itb icon="fa-chevron-left" to={Routes.pythiae_index_path(@socket, :index)} what="Back"></.itb>
<.itb icon="fa-pencil" to={Routes.pythiae_show_path(@socket, :edit, @pythiae)} what="Edit"></.itb>
<h1 class="text-3xl font-bold text-accent mx-4 py-2">Show Pythi&aelig;</h1>

<.modal :if={@live_action == :edit} id="pythiae-modal" show on_cancel={JS.patch(Routes.pythiae_show_path(@socket, :show, @pythiae))}>
    <.live_component
      module={RoomSanctumWeb.PythiaeLive.FormComponent}
      id={@pythiae.id}
      title={@page_title}
      action={@live_action}
      pythiae={@pythiae}
      patch={Routes.pythiae_show_path(@socket, :show, @pythiae)}
      current_user={@current_user}
    />
  </.modal>

<div class="mx-4 py-2">
  <div class="flex">
    <h2 class="text-2xl font-bold text-accent-300">
      <%= @pythiae.name %>
    </h2>
  </div>
  <div class="flex flex-col-reverse md:flex-col">
    <div class="flex flex flex-wrap md:flex-nowrap flex-col flex-col-reverse md:flex-row">
      <div class="card card-compact w-full md:w-1/5 bg-base-100 shadow-xl m-2">
        <div class="card-body">
          <h3 class="card-title">Visions</h3>
          <p>
              <%= for v <- @pythiae.visions do %>
                <div class="btn-group">
                  <button
                    class="btn btn-sm btn-ghost"
                    phx-click="set-current-vision"
                    phx-value-id={v}
                    disabled={v == @pythiae.curr_vision}
                    title={if v == @pythiae.curr_vision, do: "Current vision", else: "Set as current vision"}
                  >
                    <i class={"fas fa-fw fa-star #{if v == @pythiae.curr_vision, do: "text-accent"}"}></i>
                  </button>
                  <% vision = vision_by_id(v, @visions) %>
                  <a href={Routes.vision_show_path(@socket, :show, v)} class="text-sm hover:underline btn btn-sm btn-secondary gap-2">
                    <.tint_dot tint={vision && vision.meta && vision.meta.tint} />
                    <%= (vision && vision.name) || "Vision ##{v}" %>
                  </a>
                </div>
              <% end%>
          </p>
        </div>
      </div>
      <div class="card card-compact w-full md:w-2/5 bg-base-100 shadow-xl m-2">
        <div class="card-body">
          <h3 class="card-title">Ankyra</h3>
          <p>
              <%= for a <- @pythiae.ankyra do %>
                <a href={Routes.ankyra_show_path(@socket, :show, a)} class="text-sm hover:underline btn btn-secondary">
                  <%= get_by_id(a, @ankyra).topic %>
                </a>
              <% end%>
          </p>
        </div>
      </div>
      <div class="card card-compact w-full md:w-1/5 bg-base-100 shadow-xl m-2">
        <div class="card-body">
          <h3 class="card-title">Foci</h3>
          <p>
            <%= for f <- @foci do %>
              <div class="btn-group">
                <button
                  class="btn btn-sm btn-ghost"
                  phx-click="set-current-foci"
                  phx-value-id={f.id}
                  disabled={f.id == @pythiae.curr_foci}
                  title={if f.id == @pythiae.curr_foci, do: "Current foci", else: "Set as current foci"}
                >
                  <i class={"fas fa-fw fa-star #{if f.id == @pythiae.curr_foci, do: "text-accent"}"}></i>
                </button>
                <a href={Routes.foci_show_path(@socket, :show, f)} class="text-sm hover:underline btn btn-sm btn-secondary">
                  <%= f.name %>
                </a>
              </div>
            <% end %>
          </p>
        </div>
      </div>
      <div class="card card-compact w-full md:w-1/5 bg-base-100 shadow-xl m-2">
        <div class="card-body">
          <h3 class="card-title">Current Vision</h3>
          <p>
            <% current = vision_by_id(@pythiae.curr_vision, @visions) %>
            <%= if current do %>
              <a href={Routes.vision_show_path(@socket, :show, current.id)} class="text-sm hover:underline btn btn-secondary gap-2">
                <.tint_dot tint={current.meta && current.meta.tint} />
                <%= current.name %>
              </a>
            <% else %>
              <span class="text-sm opacity-60">
                <%= if @pythiae.curr_vision, do: "Vision ##{@pythiae.curr_vision} is gone", else: "None set" %>
              </span>
            <% end %>
          </p>
        </div>
      </div>
    </div>
    <div class="flex flex flex-wrap md:flex-nowrap flex-col flex-col-reverse md:flex-row">
      <div class="flex flex-col md:w-1/5 m-2">
        <div class="card card-compact w-full bg-base-100 shadow-xl">
          <div class="card-body">
            <%!-- One control with two doors: the board, and the same board read
                  through Plus. Joined rather than listed separately, because
                  "+" is a variant of the thing to its left, not a third place
                  to go. --%>
            <div class="btn-group w-full">
              <a href={~p"/p/p/#{@pythiae.name}"} class="btn btn-primary grow">Public View</a>
              <a href={~p"/p/pl/#{@pythiae.name}"} class="btn btn-primary" title="the same board, read through Plus">+</a>
            </div>
            <%!-- The same vision, drawn where its queries are. --%>
            <a href={~p"/p/m/#{@pythiae.name}"} ><button class="btn btn-primary">Public Map</button></a>
          </div>
        </div>
        <div class="card card-compact w-full bg-base-100 shadow-xl my-4">
          <div class="card-body">
            <h3 class="card-title">Control</h3>
            <p><button class="btn btn-primary" phx-click="do-publish" phx-value-id={@pythiae.id}>Publish</button></p>
            <p><button class="btn btn-primary" phx-click="do-publish-img" phx-value-id={@pythiae.id}>Image Publish</button></p>
          </div>
        </div>
      </div>
      <div class="card card-compact w-full md:w-4/5 bg-base-100 shadow-xl m-2 ">
          <div class="card-body">
            <div class="flex">
              <div class="flex-auto basis-4/5">
                <h3 class="card-title w-full">Preview</h3>
              </div>
              <div class="flex-1 w-3/4">
                &nbsp;
              </div>
              <div class="flex-none flex gap-1">
                <%!-- Raw is a lens over the reading you are on rather than a reading of
                      its own, so it toggles rather than joining the cycle. --%>
                <button
                  class={"btn btn-sm #{if @preview_raw, do: "btn-accent", else: "btn-ghost"}"}
                  phx-click="toggle-preview-raw"
                  title="the condensed data behind this view, as JSON"
                >
                  <i class="fa-solid fa-code"></i>
                </button>
                <button class="btn btn-secondary btn-sm" phx-click="toggle-preview-mode"><%= @preview_mode %></button>
              </div>
            </div>
          <%= if @preview_raw do %>
            <%= for {k, p} <- @preview do %>
            <div class="flex">
              <div class="w-16">
                <i class={"fas fa-fw fa-2xl #{get_icon(k |> elem(1))}"}></i>
              </div>
              <div class="w-7/8">
                <span class="text-secondary font-bold"><%= get_query_data(k |> elem(0), @queries, 64) %></span>
                <pre><%= condense_for(@preview_mode, k, p) |> Poison.encode!(pretty: true)%></pre>
              </div>
            </div>
            <% end %>
          <% else %>
          <%= case @preview_mode do %>
          <%= :basic -> %>
            <div class="2xl:columns-4 xl:columns-3 lg:columns-3 md:columns-2 sm:columns-2 gap-4">
            <%= for {k, p} <- @preview do %>
              <%= if p != [] do %>
              <div class="card bg-base-300 shadow-xl basis-1/3 mb-2">
                  <div class="card-body">
                      <div class="flex gap-2">
                        <i class={"fas fa-fw fa-xl #{get_icon(k |> elem(1))}"}></i>
                        <span class="text-secondary font-bold"><%= get_query_data(k |> elem(0), @queries, 64) %></span>
                      </div>
                      <%= case k do %>
                        <%= {_, :gtfs} -> %> <.p_gtfs entries={condense(k, p) |> preview(k)}> </.p_gtfs>
                        <% {_, :gbfs} -> %> <.p_gbfs entries={condense(k, p) |> preview(k)}> </.p_gbfs>
                        <% {_, :tidal} -> %>  <.p_tidal entries={condense(k, p) |> preview(k)}> </.p_tidal>
                        <% {_, :weather} -> %> <.p_weather entries={condense(k, p) |> preview(k)}> </.p_weather>
                        <% {_, :aqi} -> %> <.p_aqi entries={condense(k, p) |> preview(k)}> </.p_aqi>
                        <% {_, :ephem} -> %> <.p_ephem entries={condense(k, p) |> preview(k)}> </.p_ephem>
                        <% {_, :calendar} -> %> <.p_calendar entries={condense(k, p) |> preview(k)}> </.p_calendar>
                        <% {_, :cronos} -> %> <.p_cronos entries={condense(k, p) |> preview(k)}> </.p_cronos>
                        <% {_, :gitlab} -> %> <.p_gitlab entries={condense(k, p) |> preview(k)}> </.p_gitlab>
                        <% {_, :github} -> %> <.p_github entries={condense(k, p) |> preview(k)}> </.p_github>
                        <% {_, :drought} -> %> <.p_drought entries={condense(k, p) |> preview(k)}> </.p_drought>
                        <% {_, :pollen} -> %> <.p_pollen entries={condense(k, p) |> preview(k)}> </.p_pollen>
                        <% {_, :icarus} -> %> <.p_icarus entries={condense(k, p) |> preview(k)}> </.p_icarus>
                        <% {_, :mailbox} -> %> <.p_mailbox entries={condense(k, p) |> preview(k)}> </.p_mailbox>
                        <% {_, :treasury} -> %> <.p_treasury entries={condense(k, p) |> preview(k)}> </.p_treasury>
                        <% {_, :bourse} -> %> <.p_bourse entries={condense(k, p) |> preview(k)}> </.p_bourse>
                        <% {_, :packages} -> %> <.p_packages entries={condense(k, p) |> preview(k)}> </.p_packages>
                        <% {_, :const} -> %> <.p_const entries={condense(k, p) |> preview(k)}> </.p_const>
                      <% end %>
                      </div>
                    </div>
                    <% end %>
                <% end %>
            </div>
          <% :plus -> %>
            <div class="2xl:columns-4 xl:columns-3 lg:columns-3 md:columns-2 sm:columns-2 gap-4">
            <%= for {k, p} <- @preview do %>
              <%= if p != [] do %>
              <div class="card bg-base-300 shadow-xl basis-1/3 mb-2">
                  <div class="card-body">
                      <div class="flex gap-2">
                        <i class={"fas fa-fw fa-xl #{get_icon(k |> elem(1))}"}></i>
                        <span class="text-secondary font-bold"><%= get_query_data(k |> elem(0), @queries, 64) %></span>
                      </div>
                      <.p_plus type={k |> elem(1)} entries={condense_plus(k, p) |> preview(k)} />
                    </div>
                  </div>
              <% end %>
            <% end %>
            </div>
          <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
