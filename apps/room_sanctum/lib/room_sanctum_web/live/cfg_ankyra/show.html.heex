<.itb icon="fa-chevron-left" to={Routes.ankyra_index_path(@socket, :index)} what="Back"></.itb>
<.itb icon="fa-pencil" to={Routes.ankyra_show_path(@socket, :edit, @ankyra)} what="Edit"></.itb>

<h1 class="text-3xl font-bold text-accent mx-4 py-2">Ankyra Detail</h1>

<.modal :if={@live_action == :edit} id="amkyra-modal" show on_cancel={JS.patch(Routes.ankyra_show_path(@socket, :show, @ankyra))}>
    <.live_component
      module={RoomSanctumWeb.AnkyraLive.FormComponent}
      id={@ankyra.id}
      title={@page_title}
      action={@live_action}
      rabbit_user={@ankyra}
      patch={Routes.ankyra_show_path(@socket, :show, @ankyra)}
      current_user={@current_user}
    />
</.modal>
<div class="mx-4 py-2">
  <div class="flex items-center gap-3">
    <h2 class="text-2xl font-bold text-accent-300"><%= @ankyra.topic %>
    </h2>
    <%= case @consumer_count do %>
      <% nil -> %>
        <span class="badge badge-ghost gap-2">
          <i class="fas fa-fw fa-circle-notch fa-spin"></i> checking
        </span>
      <% 0 -> %>
        <span class="badge badge-error gap-2">
          <i class="fas fa-fw fa-plug-circle-xmark"></i> no subscribers
        </span>
      <% n -> %>
        <span class="badge badge-success gap-2" title={Enum.join(@connected_client_ids, ", ")}>
          <i class="fas fa-fw fa-plug"></i> <%= n %> subscriber<%= if n == 1, do: "", else: "s" %>
        </span>
    <% end %>
  </div>
  <div class="flex">
    <div class="card card-compact w-2/4 bg-base-100 shadow-xl m-2">
      <div class="card-body">
        <h3 class="card-title">MQTT Credentials</h3>
        <ul class="menu p-3 bg-base-200 rounded-xl">
          <li><a>Username: <pre><%= @ankyra.username %></pre></a></li>
          <li><a>Password: <pre><%= @ankyra.password %></pre></a></li>
          <li><a>Topic: <pre><%= @ankyra.topic %></pre> </a></li>
        </ul>
      </div>
    </div>
    <div class="card card-compact w-2/4 bg-base-100 shadow-xl m-2">
      <div class="card-body">
        <h3 class="card-title">Mosquitto Example Commands</h3>
        <pre class="whitespace-pre-line">mosquitto_sub -h $HOSTNAME -u <%= @ankyra.username %> -P <%= @ankyra.password %> -t <%= @ankyra.topic %></pre>
        <pre class="whitespace-pre-line">mosquitto_pub -h $HOSTNAME -u <%= @ankyra.username %> -P <%= @ankyra.password %> -t <%= @ankyra.topic %> -m "$message"</pre>
      </div>
    </div>
  </div>
  <div class="card card-compact w-full bg-base-100 shadow-xl m-2">
    <div class="card-body">
      <h3 class="card-title">Pair a Client</h3>
      <p class="text-sm opacity-70">
        Scan with the phone's camera. The link carries this Ankyra's credentials
        and topic, so nothing is retyped — Apollo's Crib for Android opens it and
        connects. The broker's address is not the app's, so check it here.
      </p>
      <div class="flex flex-wrap items-start gap-4">
        <div class="bg-white p-3 rounded-xl shrink-0 w-64 [&>svg]:w-full [&>svg]:h-auto">
          <%= Phoenix.HTML.raw(@pairing_qr) %>
        </div>
        <div class="flex-1 min-w-[18rem]">
          <form phx-change="set-broker" class="flex flex-wrap gap-2 items-end">
            <label class="form-control">
              <span class="label-text">Broker host</span>
              <input
                type="text"
                name="host"
                value={@broker.host}
                class="input input-bordered input-sm font-mono"
                autocomplete="off"
              />
            </label>
            <label class="form-control">
              <span class="label-text">Port</span>
              <input
                type="number"
                name="port"
                value={@broker.port}
                class="input input-bordered input-sm w-24 font-mono"
              />
            </label>
            <label class="label cursor-pointer gap-2">
              <span class="label-text">TLS</span>
              <input type="checkbox" name="tls" class="toggle toggle-accent toggle-sm" checked={@broker.tls} />
            </label>
          </form>
          <pre class="mt-3 text-xs whitespace-pre-wrap break-all opacity-70"><%= @pairing_uri %></pre>
          <%= if @ankyra.auto_register_clients do %>
            <p class="text-sm opacity-70 mt-2">
              The client registers its own id on first connect.
            </p>
          <% else %>
            <p class="text-sm text-warning mt-2">
              <i class="fas fa-fw fa-triangle-exclamation"></i>
              Auto-register is off — add the client's id below, or its first
              connection will be refused.
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="card card-compact w-full bg-base-100 shadow-xl m-2">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <h3 class="card-title">Allowed Client IDs</h3>
        <label class="label cursor-pointer gap-2">
          <span class="label-text">Auto-register new client IDs</span>
          <input
            type="checkbox"
            class="toggle toggle-accent"
            checked={@ankyra.auto_register_clients}
            phx-click="toggle-auto-register"
          />
        </label>
      </div>

      <div class="flex flex-wrap gap-2 my-2">
        <%= if @ankyra.client_ids == [] and @connected_client_ids == [] do %>
          <span class="text-sm opacity-60">
            <%= if @ankyra.auto_register_clients, do: "No client IDs yet — first connection will be auto-registered.", else: "No client IDs registered. Add one below or enable auto-register; otherwise all connections will be denied." %>
          </span>
        <% else %>
          <%= for cid <- @ankyra.client_ids do %>
            <div class="badge badge-secondary gap-2 p-3">
              <%= if cid in @connected_client_ids do %>
                <i class="fas fa-fw fa-circle text-success text-[0.5rem]" title="Connected now"></i>
              <% else %>
                <i class="fas fa-fw fa-circle opacity-30 text-[0.5rem]" title="Not connected"></i>
              <% end %>
              <span class="font-mono"><%= cid %></span>
              <button
                phx-click="remove-client-id"
                phx-value-client_id={cid}
                title="Remove client ID"
                class="hover:text-error"
              >
                <i class="fas fa-fw fa-xmark"></i>
              </button>
            </div>
          <% end %>
          <%= for cid <- unregistered_connected(@ankyra, @connected_client_ids) do %>
            <div class="badge badge-secondary badge-outline gap-2 p-3" title="Connected and registered since this page was loaded — reload to manage it">
              <i class="fas fa-fw fa-circle text-success text-[0.5rem]"></i>
              <span class="font-mono"><%= cid %></span>
            </div>
          <% end %>
        <% end %>
      </div>

      <form phx-submit="add-client-id" class="flex gap-2">
        <input
          type="text"
          name="client_id"
          placeholder="new-client-id"
          class="input input-bordered input-sm flex-1 font-mono"
          autocomplete="off"
        />
        <button type="submit" class="btn btn-sm btn-secondary">
          <i class="fas fa-fw fa-plus"></i> Add
        </button>
      </form>
    </div>
  </div>
</div>