<!DOCTYPE html>
<html data-theme="her" class="h-full">
<head>
  <meta charset="utf-8"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <%= csrf_meta_tag() %>
  <.basemap_meta />
  <%= live_title_tag assigns[:page_title] || "RoomSanctum", suffix: " · Apollos Crib" %>
  <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css")}/>
  <script defer phx-track-static type="text/javascript" src={Routes.static_path(@conn, "/assets/app.js")}></script>
</head>
<%!-- No padding, no card, no scrollbar: the page is the map. The other public
      layouts wrap their content in a bordered panel, which is right for a
      board of cards and wrong for something meant to fill a screen on a wall. --%>
<body class="h-full overflow-hidden">
<%= @inner_content %>
</body>
</html>
