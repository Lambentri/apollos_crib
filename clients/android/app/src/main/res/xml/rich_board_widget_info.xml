<?xml version="1.0" encoding="utf-8"?>
<!-- The detailed board as a home screen widget: one card at a time, cycled
     by the host.

     Larger than its compact sibling by default, because that is the point of
     it — a headline and a handful of named values need room that four rows
     of glyph-and-number do not.

     `autoAdvanceViewId` asks for the cycling: the flipper advances itself on
     launchers that honour it, and can be swiped by hand on the ones that do
     not.

     No `updatePeriodMillis`: a board arrives when a Pythiae publishes one, and
     the service notifies the widget then. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="70dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="400dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_rich_board"
    android:previewLayout="@layout/widget_rich_board"
    android:autoAdvanceViewId="@id/rich_flipper"
    android:widgetCategory="home_screen"
    android:description="@string/rich_widget_description" />
