# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Mnesia store created at runtime by wheretz
/Mnesia.*/

# Server logs
*.log

# Local credentials for development and investigation. Never committed.
.env

# Android release signing material. The APK signing key cannot be
# rotated — Android checks its certificate on every update — so a
# commit of one is not recoverable by deleting it later. Keep it in
# OpenBao KV and in the CI secret, never here.
# See clients/android/README.md#the-release-keystore.
*.jks
*.keystore
keystore.pass
